---
import CookieBanner from './CookieBanner.astro';
interface Props { contactTarget?: string; showHome?: boolean; }
const { contactTarget = '#contatti', showHome = true } = Astro.props;
---

<script is:inline src="/analytics-consent.js" defer></script>
<header>
  <a class="brand brand-image" href="/" aria-label="4 Web Lab, home"><img src="/4weblab-logo-header.svg" width="240" height="88" alt="4 Web Lab" /></a>
  <nav aria-label="Navigazione principale">
    {showHome && <a class="nav-home" href="/" aria-label="Home"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1Z" /></svg></a>}
    <a href="/perizia-sito-web">Perizia</a>
    <details class="service-menu">
      <summary>Servizi <span aria-hidden="true">+</span></summary>
      <div class="service-menu-panel">
        <a href="/sito-web-per-negozio">Siti per negozi</a>
        <a href="/sito-web-per-professionisti">Siti per professionisti</a>
        <a href="/sito-web-aziendale">Siti web aziendali</a>
        <a href="/pubblicita-su-google">Google Ads</a>
        <a href="/pubblicita-su-chatgpt">ChatGPT Ads</a>
      </div>
    </details>
    <a href="/realizzazioni">Portfolio</a>
    <a href="/zone-servite">Zone servite</a>
    <a href="/blog">Blog</a>
    <a href="/faq-realizzazione-siti-web">FAQ</a>
    <a href="/contatti">Contatti</a>
  </nav>
  <div class="header-actions">
    <a class="top-cta" href="tel:+393514656042"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 2.9 9.4 2a1.8 1.8 0 0 1 2 1l1.2 4a1.8 1.8 0 0 1-.8 2L10.3 10a13.5 13.5 0 0 0 3.7 3.7l1-1.5a1.8 1.8 0 0 1 2-.8l4 1.2a1.8 1.8 0 0 1 1 2l-.9 2.8a2.7 2.7 0 0 1-2.6 1.9C10 19.3 4.7 14 4.7 5.5A2.7 2.7 0 0 1 6.6 2.9Z" /></svg>Chiamaci</a>
    <details class="mobile-menu">
      <summary aria-label="Apri il menu di navigazione"><span class="mobile-menu-icon" aria-hidden="true"></span><span class="sr-only">Apri il menu</span></summary>
      <div class="mobile-menu-panel">
        <nav aria-label="Navigazione mobile">
          <a href="/">Home</a>
          <a href="/perizia-sito-web">Perizia</a>
          <details class="mobile-service-menu">
            <summary>Servizi <span aria-hidden="true">+</span></summary>
            <div class="mobile-service-links">
              <a href="/sito-web-per-negozio">Sito web per negozio</a>
              <a href="/sito-web-per-professionisti">Sito web per professionisti</a>
              <a href="/sito-web-aziendale">Sito web aziendale</a>
              <a href="/pubblicita-su-google">Pubblicità su Google</a>
              <a href="/pubblicita-su-chatgpt">Pubblicità su ChatGPT</a>
            </div>
          </details>
          <a href="/realizzazioni">Portfolio</a>
          <a href="/zone-servite">Zone servite</a>
          <a href="/blog">Blog</a>
          <a href="/faq-realizzazione-siti-web">FAQ</a>
          <a href="/contatti">Contatti</a>
        </nav>
      </div>
    </details>
  </div>
</header>
<CookieBanner />


