<section class="cookie-banner" data-cookie-banner aria-label="Preferenze cookie" hidden>
  <div class="cookie-banner__content">
    <p class="eyebrow">Cookie</p>
    <h2>Rispettiamo la tua privacy</h2>
    <p>Usiamo cookie tecnici necessari al funzionamento del sito e, previo consenso, cookie statistici per misurare in forma aggregata come viene utilizzato il sito. Puoi accettare, rifiutare o scegliere quali attivare.</p>
    <p class="cookie-banner__links"><a href="/cookie">Leggi la Cookie policy</a></p>
    <button class="cookie-banner__close" type="button" data-cookie-action="deny" aria-label="Rifiuta i cookie statistici e chiudi">×</button>
    <div class="cookie-banner__actions" data-cookie-main-actions>
      <button class="cookie-button cookie-button--secondary" type="button" data-cookie-action="deny">Rifiuta</button>
      <button class="cookie-button cookie-button--secondary" type="button" data-cookie-action="customize">Personalizza</button>
      <button class="cookie-button" type="button" data-cookie-action="accept">Accetta</button>
    </div>
    <form class="cookie-banner__preferences" data-cookie-preferences hidden>
      <label class="cookie-banner__necessary"><input type="checkbox" checked disabled /> Tecnici necessari <span>Sempre attivi</span></label>
      <label><input type="checkbox" name="analytics" /> Analytics <span>Misura in forma aggregata le visite e le pagine consultate.</span></label>
      <div class="cookie-banner__actions">
        <button class="cookie-button cookie-button--secondary" type="button" data-cookie-action="back">Indietro</button>
        <button class="cookie-button" type="submit">Salva preferenze</button>
      </div>
    </form>
  </div>
</section>
<button class="cookie-settings-trigger" type="button" data-open-cookie-preferences aria-label="Gestisci le preferenze cookie">Cookie</button>

<script is:inline>
  (() => {
    const preferenceKey = '4weblab-cookie-preferences';
    const banner = document.querySelector('[data-cookie-banner]');
    if (!banner) return;

    const preferences = banner.querySelector('[data-cookie-preferences]');
    const mainActions = banner.querySelector('[data-cookie-main-actions]');
    const analytics = preferences?.querySelector('input[name="analytics"]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let panelAnimation;

    const maxAge = 183 * 24 * 60 * 60 * 1000;
    const hasSavedPreference = () => {
      try {
        const value = JSON.parse(window.localStorage.getItem(preferenceKey) || 'null');
        if (!value?.updatedAt || Date.now() - new Date(value.updatedAt).getTime() > maxAge) {
          window.localStorage.removeItem(preferenceKey);
          return false;
        }
        return typeof value.analytics === 'boolean';
      } catch { return false; }
    };

    const save = (analyticsAllowed) => {
      try {
        window.localStorage.setItem(preferenceKey, JSON.stringify({
          version: 1,
          analytics: analyticsAllowed,
          updatedAt: new Date().toISOString(),
        }));
      } catch {
        // The current-page choice still applies if browser storage is unavailable.
      }
      window.dispatchEvent(new CustomEvent('4weblab:analytics-consent', {
        detail: { analytics: analyticsAllowed },
      }));
      banner.hidden = true;
    };

    const animatePanel = (element, entering) => {
      if (!(element instanceof HTMLElement) || typeof element.animate !== 'function') return null;
      panelAnimation?.cancel();
      const reduced = reducedMotion.matches;
      const frames = reduced
        ? [{ opacity: entering ? 0 : 1 }, { opacity: entering ? 1 : 0 }]
        : entering
          ? [{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }]
          : [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(4px)' }];
      panelAnimation = element.animate(frames, { duration: reduced ? 80 : entering ? 160 : 120, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' });
      return panelAnimation;
    };

    const showPreferences = () => {
      if (!(preferences instanceof HTMLElement) || !(mainActions instanceof HTMLElement)) return;
      banner.hidden = false;
      const reveal = () => {
        preferences.hidden = false;
        animatePanel(preferences, true);
        analytics?.focus();
      };
      if (mainActions.hidden) { reveal(); return; }
      const animation = animatePanel(mainActions, false);
      if (!animation) { mainActions.hidden = true; reveal(); return; }
      animation.finished.catch(() => undefined).then(() => {
        if (panelAnimation !== animation) return;
        mainActions.hidden = true;
        reveal();
      });
    };

    const showMainActions = () => {
      if (!(preferences instanceof HTMLElement) || !(mainActions instanceof HTMLElement)) return;
      const reveal = () => {
        mainActions.hidden = false;
        animatePanel(mainActions, true);
        mainActions.querySelector('[data-cookie-action="customize"]')?.focus();
      };
      const animation = animatePanel(preferences, false);
      if (!animation) { preferences.hidden = true; reveal(); return; }
      animation.finished.catch(() => undefined).then(() => {
        if (panelAnimation !== animation) return;
        preferences.hidden = true;
        reveal();
      });
    };

    const openPreferences = () => {
      banner.hidden = false;
      showPreferences();
    };

    window.fourWebLabCookiePreferences = { open: openPreferences };
    if (!hasSavedPreference()) banner.hidden = false;

    banner.querySelector('[data-cookie-action="accept"]')?.addEventListener('click', () => save(true));
    banner.querySelectorAll('[data-cookie-action="deny"]').forEach((button) => {
      button.addEventListener('click', () => save(false));
    });
    banner.querySelector('[data-cookie-action="customize"]')?.addEventListener('click', () => {
      openPreferences();
    });
    banner.querySelector('[data-cookie-action="back"]')?.addEventListener('click', () => {
      showMainActions();
    });
    preferences?.addEventListener('submit', (event) => {
      event.preventDefault();
      save(Boolean(analytics?.checked));
    });
    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-open-cookie-preferences]');
      if (!trigger) return;
      event.preventDefault();
      openPreferences();
    });
  })();
</script>
