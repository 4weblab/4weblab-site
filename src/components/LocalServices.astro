---
const services = [
  {
    title: 'Siti web',
    description: 'Per presentare la tua attività, i servizi e i contatti.',
    links: [
      { label: 'Siti per negozi', href: '/sito-web-per-negozio/' },
      { label: 'Siti per professionisti', href: '/sito-web-per-professionisti/' },
      { label: 'Siti web aziendali', href: '/sito-web-aziendale/' },
    ],
  },
  {
    title: 'Google Ads',
    description: 'Per raggiungere chi sta già cercando i tuoi prodotti o servizi su Google.',
    links: [{ label: 'Scopri Google Ads', href: '/pubblicita-su-google/' }],
  },
  {
    title: 'ChatGPT Ads',
    description: 'Per capire come funzionano gli annunci su ChatGPT e quando valutarli.',
    links: [{ label: 'Scopri ChatGPT Ads', href: '/pubblicita-su-chatgpt/' }],
  },
];
---

<section class="local-services" id="servizi" aria-labelledby="local-services-title">
  <div class="wrap">
    <h2 id="local-services-title">Esplora i servizi di 4 Web Lab</h2>
    <div class="service-grid">
      {services.map(({ title, description, links }) => (
        <article class:list={['service-card', { 'site-card': links.length > 1 }]}>
          <h3>{title}</h3>
          <p>{description}</p>
          <ul>
            {links.map(({ label, href }) => (
              <li><a href={href}>{label}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .local-services {
    padding-block: clamp(48px, 6vw, 84px);
    background: var(--ink);
    color: var(--paper);
    scroll-margin-top: 95px;
  }

  .local-services h2 { margin: 0 0 clamp(24px, 3vw, 38px); }

  .service-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 2.3vw, 32px);
    border: 1px solid #ffffff36;
    border-radius: 12px;
    background: linear-gradient(155deg, #20334d, #172439 76%);
  }

  .site-card { border-top: 3px solid var(--lime); }
  .service-card h3 { margin: 0 0 10px; font: 700 clamp(23px, 2.2vw, 30px)/1.1 var(--sans); }
  .service-card p { margin: 0 0 22px; color: #d0d9e6; line-height: 1.5; }
  .service-card ul { margin: auto 0 0; padding: 0; list-style: none; }

  .service-card a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 6px;
    background: var(--lime);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .site-card li + li { margin-top: 4px; }
  .site-card a { background: #ffffff09; color: var(--lime); }
  .service-card a:hover { background: var(--paper); color: var(--ink); }

  @media (max-width: 760px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>
