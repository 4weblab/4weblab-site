---
import { SITE, organizationStructuredData, sitePath, websiteStructuredData } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const { title, description, image, type = 'website', noindex = false, structuredData = [] } = Astro.props;
const canonicalPath = Astro.url.pathname;
const canonical = sitePath(canonicalPath);
const socialImage = image ? new URL(image, SITE.url).toString() : undefined;
const baseStructuredData = noindex ? [] : [organizationStructuredData, websiteStructuredData];
const jsonLd = [...baseStructuredData, ...structuredData];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#101a2d" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101a2d" />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="describedby" href="/llms.txt" />
<meta property="og:type" content={type} />
<meta property="og:locale" content="it_IT" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{socialImage && <meta property="og:image" content={socialImage} />}
<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
<title>{title}</title>
{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}


