---
import copyData from '../data/service-copy.json';
import CompanyStructure from './CompanyStructure.astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props { content: typeof copyData.aziende; promotional: boolean; ordinarySubmit: string }
const { content, promotional, ordinarySubmit } = Astro.props;
const [audience, research, materials, architecture, enquiries, process, price] = content.sections;
// Split only at existing paragraph/list boundaries. Every original word is rendered once.
const paragraphs = (html: string) => [...html.matchAll(/<p\b[^>]*>(.*?)<\/p>/gs)].map(match => match[1]);
const audienceParagraphs = paragraphs(audience.html);
const researchParagraphs = paragraphs(research.html);
const enquiryParagraphs = paragraphs(enquiries.html);
const processItems = [...process.html.matchAll(/<li><strong>(.*?)<\/strong>(.*?)<\/li>/gs)].map(match => ({ title: match[1], body: match[2] }));
const priceHtml = promotional ? price.html : price.ordinaryHtml ?? price.html;
const priceBlocks = [...priceHtml.matchAll(/<p\b[^>]*>.*?<\/p>|<ul>.*?<\/ul>/gs)].map(match => match[0]);
const priceListIndex = priceBlocks.findIndex(block => block.startsWith('<ul>'));
const priceIntro = priceBlocks.slice(0, priceListIndex).join('');
const priceDetails = priceBlocks.slice(priceListIndex).join('');
---
<section class="company-hero">
  <div class="wrap company-hero-grid">
    <div class="company-hero-copy">
      <p class="hero-location">{content.eyebrow}</p>
      <h1>{content.h1}</h1>
      <div class="company-hero-text" set:html={content.heroHtml} />
      {!promotional && <p class="company-ordinary-price">Da 1.890 € + IVA.</p>}
      <div class="actions"><a class="button" href={`#${content.contactId}`}>{promotional ? content.primary : ordinarySubmit}</a><a class="plain" href="#prezzo-aziendale">{content.secondary}</a></div>
      {promotional && <div class="company-promotion" set:html={content.promoHtml} />}
    </div>
    <div class="company-hero-art" aria-hidden="true">
      <ResponsiveImage src="/images/aziende-direction-3/architettura-pagine.webp" width={1200} height={1200} sizes="(max-width: 900px) calc(100vw - 40px), 46vw" alt="" loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>

<section id={audience.id} class="company-audience company-section">
  <div class="wrap">
    <h2>{audience.title}</h2>
    <p class="company-question" set:html={audienceParagraphs[0]} />
    <div class="company-reading-pair">{audienceParagraphs.slice(1).map(paragraph => <p set:html={paragraph} />)}</div>
  </div>
</section>

<section id={research.id} class="company-research company-section">
  <div class="wrap">
    <h2>{research.title}</h2>
    <div class="company-research-grid">{researchParagraphs.map((paragraph, index) => <div class="company-research-part">
      <div class="company-research-sign" aria-hidden="true">
        {index === 0 ? <svg viewBox="0 0 120 72" fill="none"><rect x="12" y="13" width="58" height="33" rx="3" stroke="currentColor" /><path d="M24 46V57L39 46M50 26H108V58H92L80 68V58H50V26Z" fill="#F5F4EF" stroke="currentColor" /><path d="M24 24H56M24 31H44M63 38H94M63 45H84" stroke="currentColor" /></svg>
        : index === 1 ? <svg viewBox="0 0 120 72" fill="none"><rect x="6" y="22" width="37" height="43" rx="2" stroke="currentColor" /><rect x="41" y="8" width="38" height="57" rx="2" fill="#F5F4EF" stroke="currentColor" /><rect x="77" y="22" width="37" height="43" rx="2" fill="#F5F4EF" stroke="currentColor" /><path d="M49 20H71M49 28H71M14 33H34M86 33H106" stroke="currentColor" /><rect x="49" y="39" width="22" height="17" fill="#D7F54A" /></svg>
        : <svg viewBox="0 0 120 72" fill="none"><rect x="7" y="13" width="106" height="44" rx="4" stroke="currentColor" /><circle cx="30" cy="33" r="10" stroke="currentColor" /><path d="M37 40L45 48M58 27H98M58 36H86M58 45H94" stroke="currentColor" /><rect x="98" y="13" width="15" height="44" rx="3" fill="#D7F54A" /></svg>}
      </div>
      <p set:html={paragraph} />
    </div>)}</div>
  </div>
</section>

<section id={materials.id} class="company-materials company-section">
  <div class="wrap company-materials-grid">
    <div class="company-materials-art" aria-hidden="true"><ResponsiveImage src="/images/aziende-direction-3/materiali-contenuti.webp" width={1440} height={960} sizes="(max-width: 900px) calc(100vw - 40px), 52vw" alt="" /></div>
    <div class="company-materials-copy"><h2>{materials.title}</h2><div class="company-prose" set:html={materials.html} /></div>
  </div>
</section>

<CompanyStructure title={architecture.title} html={architecture.html} id={architecture.id} />

<section id={enquiries.id} class="company-enquiries company-section">
  <div class="wrap company-enquiries-grid">
    <div><h2>{enquiries.title}</h2><div class="company-prose">{enquiryParagraphs.map(paragraph => <p set:html={paragraph} />)}</div></div>
    <div class="company-form-visual" aria-hidden="true">
      <svg viewBox="0 0 600 490" fill="none">
        <path d="M60 76H540M300 36V450" stroke="#CFD7CC" stroke-dasharray="3 6" />
        <rect x="132" y="43" width="350" height="419" rx="8" fill="#101A2D" opacity=".06" />
        <rect x="125" y="36" width="350" height="419" rx="8" fill="#FFFFFF" stroke="#BCC9BC" />
        <path d="M125 67H475" stroke="#DAE1D5" /><circle cx="143" cy="52" r="2" fill="#899B86" /><circle cx="153" cy="52" r="2" fill="#899B86" /><circle cx="163" cy="52" r="2" fill="#899B86" />
        <rect x="154" y="94" width="170" height="10" rx="2" fill="#101A2D" /><rect x="154" y="115" width="218" height="4" rx="1" fill="#A2B09E" />
        <rect x="154" y="145" width="119" height="37" rx="3" fill="#F5F7F2" stroke="#D8E0D2" /><rect x="285" y="145" width="161" height="37" rx="3" fill="#F5F7F2" stroke="#D8E0D2" />
        <rect x="154" y="196" width="292" height="37" rx="3" fill="#F5F7F2" stroke="#D8E0D2" /><rect x="154" y="247" width="292" height="84" rx="3" fill="#F5F7F2" stroke="#D8E0D2" />
        <rect x="154" y="352" width="292" height="41" rx="3" fill="#D7F54A" /><path d="M280 372H321M314 365L321 372L314 379" stroke="#101A2D" stroke-width="2" />
        <rect x="154" y="414" width="213" height="3" rx="1" fill="#B2BFAE" />
        <path d="M477 341L508 395L488 394L479 414L461 406L470 387L453 377L477 341Z" fill="#101A2D" stroke="#FFFFFF" stroke-width="3" />
      </svg>
    </div>
  </div>
</section>

<section id={process.id} class="company-process company-section">
  <div class="wrap"><h2>{process.title}</h2><ol>{processItems.map(item => <li><h3 set:html={item.title} /><p set:html={item.body} /></li>)}</ol></div>
</section>

<section id={price.id} class="company-offer company-section">
  <div class="wrap"><h2>{price.title}</h2><div class="company-offer-grid"><div class="company-offer-price" set:html={priceIntro} /><div class="company-offer-details" set:html={priceDetails} /></div></div>
</section>
