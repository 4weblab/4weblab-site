---
const endpoint = '/.netlify/functions/assistant';
---

<aside class="assistant-widget" aria-label="Assistente Francesco">
  <button class="assistant-launcher" type="button" aria-expanded="false" aria-controls="assistant-panel"><span aria-hidden="true">✦</span><span>Parla con Francesco</span></button>
  <section id="assistant-panel" class="assistant-panel" hidden aria-live="polite">
    <header><div><p>4 WEB LAB</p><h2>Francesco</h2><span>Agente IA istruito da 4 Web Lab</span></div><button class="assistant-close" type="button" aria-label="Chiudi assistente">×</button></header>
    <div class="assistant-messages" role="log" aria-label="Conversazione con Francesco"><article class="assistant-message assistant-message--assistant">Ciao, sono Francesco, agente IA istruito da 4 Web Lab. Posso aiutarLa a orientarsi tra Perizia, sito nuovo e pubblicità. 4 Web Lab non salva questa conversazione in un database; i messaggi vengono inviati al fornitore IA solo per generare la risposta. Eviti quindi dati personali qui in chat. Da dove vuole partire?</article></div>
    <form class="assistant-form"><label class="sr-only" for="assistant-input">Scrivi a Francesco</label><textarea id="assistant-input" rows="2" maxlength="750" placeholder="Es. Ho un sito ma non ricevo contatti"></textarea><button type="submit">Invia</button></form>
    <p class="assistant-note">Per un preventivo o per essere ricontattato: <a href="/contatti">modulo contatti</a> · <a href="https://wa.me/393514656042">WhatsApp</a></p>
  </section>
</aside>

<script define:vars={{ endpoint }}>
  const widget = document.querySelector('.assistant-widget');
  const launcher = widget?.querySelector('.assistant-launcher'); const panel = widget?.querySelector('.assistant-panel'); const close = widget?.querySelector('.assistant-close');
  const form = widget?.querySelector('.assistant-form'); const input = widget?.querySelector('#assistant-input'); const messagesBox = widget?.querySelector('.assistant-messages'); const history = [];
  const addMessage = (role, content) => { const item = document.createElement('article'); item.className = `assistant-message assistant-message--${role}`; item.textContent = content; messagesBox?.append(item); messagesBox?.scrollTo({ top: messagesBox.scrollHeight, behavior: 'smooth' }); };
  launcher?.addEventListener('click', () => { panel.hidden = false; launcher.setAttribute('aria-expanded', 'true'); input?.focus(); }); close?.addEventListener('click', () => { panel.hidden = true; launcher.setAttribute('aria-expanded', 'false'); launcher.focus(); });
  form?.addEventListener('submit', async (event) => { event.preventDefault(); const content = input?.value.trim(); if (!content) return; addMessage('user', content); history.push({ role: 'user', content }); input.value = ''; input.disabled = true; const button = form.querySelector('button'); button.disabled = true; button.textContent = 'Invio…'; try { const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history, pagePath: window.location.pathname }) }); const data = await response.json(); if (!response.ok) throw new Error(data.message); addMessage('assistant', data.reply); history.push({ role: 'assistant', content: data.reply }); } catch (error) { addMessage('assistant', error instanceof Error ? error.message : 'Non riesco a rispondere ora. Può contattarci dal modulo o su WhatsApp.'); } finally { input.disabled = false; button.disabled = false; button.textContent = 'Invia'; input.focus(); } });
</script>

<style>
  .assistant-widget{position:fixed;z-index:30;right:1rem;bottom:1rem;font:inherit}.assistant-launcher{display:flex;gap:.55rem;align-items:center;border:0;border-radius:999px;background:#c5ff64;color:#111;padding:.8rem 1rem;font-weight:700;box-shadow:0 8px 24px #0003;cursor:pointer}.assistant-panel{position:absolute;right:0;bottom:3.75rem;display:flex;flex-direction:column;width:min(23rem,calc(100vw - 2rem));max-height:calc(100svh - 1.5rem);overflow:hidden;border:1px solid #ffffff28;border-radius:1rem;background:#14231d;color:#f6f5ef;box-shadow:0 18px 50px #0008}.assistant-panel header{position:static;z-index:auto;inset:auto;display:flex;height:auto;align-items:flex-start;justify-content:space-between;padding:1rem;border-bottom:1px solid #ffffff1c;color:inherit}.assistant-panel header p{margin:0;color:#c5ff64;font-size:.7rem;letter-spacing:.1em}.assistant-panel h2{margin:.15rem 0;font:600 1.15rem/1.1 var(--sans);letter-spacing:0}.assistant-panel header span,.assistant-note{font-size:.75rem;color:#d4ddd6}.assistant-close{flex:none;border:0;background:transparent;color:inherit;font-size:1.75rem;line-height:1;cursor:pointer}.assistant-messages{min-height:0;max-height:19rem;overflow:auto;padding:1rem;display:grid;gap:.7rem}.assistant-message{padding:.7rem .8rem;border-radius:.75rem;font-size:.9rem;line-height:1.45}.assistant-message--assistant{background:#ffffff12}.assistant-message--user{background:#c5ff64;color:#14231d;margin-left:2rem}.assistant-form{display:flex;gap:.5rem;padding:0 1rem .65rem}.assistant-form textarea{min-width:0;flex:1;resize:vertical;border:1px solid #ffffff3b;border-radius:.5rem;background:#fff;color:#15251e;padding:.55rem;font:inherit}.assistant-form button{border:0;border-radius:.5rem;background:#c5ff64;color:#13231c;padding:.55rem .7rem;font-weight:700;cursor:pointer}.assistant-note a{color:#c5ff64}.assistant-note{margin:0;padding:0 1rem 1rem}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:480px){.assistant-launcher span:last-child{display:none}.assistant-launcher{padding:.85rem}.assistant-widget{right:.75rem;bottom:.75rem}.assistant-messages{max-height:calc(100svh - 15rem)}}
</style>
