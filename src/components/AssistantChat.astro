---
const endpoint = '/.netlify/functions/assistant';
---

<aside class="assistant-widget" aria-label="Assistente Francesco">
  <button class="assistant-launcher" type="button" aria-expanded="false" aria-controls="assistant-panel" aria-label="Apri l'assistente Francesco"><span class="assistant-launcher__label" aria-hidden="true"><svg class="assistant-launcher__icon" viewBox="0 0 24 24" fill="none" focusable="false"><path d="M5.25 6.75A3.75 3.75 0 0 1 9 3h6a3.75 3.75 0 0 1 3.75 3.75v4.5A3.75 3.75 0 0 1 15 15h-3.4L7.25 19v-4.6a3.75 3.75 0 0 1-2-3.15v-4.5Z"/><path d="M9 8.75h6M9 11.75h3.75"/></svg></span><span class="sr-only">Parla con Francesco</span></button>
  <section id="assistant-panel" class="assistant-panel" hidden aria-live="polite">
    <header><div><p>4 WEB LAB</p><h2>Francesco</h2><span>Agente IA istruito da 4 Web Lab</span></div><button class="assistant-close" type="button" aria-label="Chiudi assistente">×</button></header>
    <div class="assistant-messages" role="log" aria-label="Conversazione con Francesco"><article class="assistant-message assistant-message--assistant">Salve, sono Francesco, agente IA istruito da 4 Web Lab. Posso aiutarLa a orientarsi tra Perizia, sito nuovo e pubblicità. 4 Web Lab non salva questa conversazione in un database; i messaggi vengono inviati al fornitore IA solo per generare la risposta. Eviti quindi dati personali qui in chat. Da dove vuole partire?</article></div>
    <form class="assistant-form"><label class="sr-only" for="assistant-input">Scrivi a Francesco</label><textarea id="assistant-input" rows="2" maxlength="750" placeholder="Es. Ho un sito ma non ricevo contatti"></textarea><button type="submit">Invia</button></form>
    <p class="assistant-note">Per un preventivo o per essere ricontattato: <a href="/contatti/">modulo contatti</a> · <a href="https://wa.me/393514656042">WhatsApp</a></p>
  </section>
</aside>

<script define:vars={{ endpoint }}>
  const widget = document.querySelector('.assistant-widget');
  const launcher = widget?.querySelector('.assistant-launcher'); const launcherSymbol = launcher?.querySelector('[aria-hidden="true"]'); const launcherIcon = launcherSymbol?.innerHTML || ''; const panel = widget?.querySelector('.assistant-panel'); const close = widget?.querySelector('.assistant-close');
  const form = widget?.querySelector('.assistant-form'); const input = widget?.querySelector('#assistant-input'); const messagesBox = widget?.querySelector('.assistant-messages'); const history = [];
  const addMessage = (role, content) => { const item = document.createElement('article'); item.className = `assistant-message assistant-message--${role}`; item.textContent = content; messagesBox?.append(item); messagesBox?.scrollTo({ top: messagesBox.scrollHeight, behavior: 'smooth' }); };
  const openPanel = () => { if (panel) panel.hidden = false; widget?.classList.add('assistant-widget--open'); launcher?.setAttribute('aria-expanded', 'true'); launcher?.setAttribute('aria-label', 'Chiudi l\'assistente Francesco'); if (launcherSymbol) launcherSymbol.textContent = '×'; input?.focus(); };
  const closePanel = () => { if (panel) panel.hidden = true; widget?.classList.remove('assistant-widget--open'); launcher?.setAttribute('aria-expanded', 'false'); launcher?.setAttribute('aria-label', 'Apri l\'assistente Francesco'); if (launcherSymbol) launcherSymbol.innerHTML = launcherIcon; launcher?.focus(); };
  const togglePanel = () => { if (panel?.hidden) openPanel(); else closePanel(); };
  launcher?.addEventListener('click', togglePanel); close?.addEventListener('click', closePanel);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !panel?.hidden) closePanel(); });
  input?.addEventListener('keydown', (event) => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); form?.requestSubmit(); } });
  form?.addEventListener('submit', async (event) => { event.preventDefault(); const content = input?.value.trim(); if (!content) return; addMessage('user', content); history.push({ role: 'user', content }); input.value = ''; input.disabled = true; const button = form.querySelector('button'); button.disabled = true; button.textContent = 'Invio…'; try { const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history, pagePath: window.location.pathname }) }); const contentType = response.headers.get('content-type') || ''; if (!contentType.includes('application/json')) throw new Error('unavailable'); const data = await response.json(); if (!response.ok || typeof data.reply !== 'string') throw new Error('unavailable'); addMessage('assistant', data.reply); history.push({ role: 'assistant', content: data.reply }); } catch { addMessage('assistant', 'Il servizio non è disponibile in questo momento. Può contattarci dal modulo o su WhatsApp.'); } finally { input.disabled = false; button.disabled = false; button.textContent = 'Invia'; input.focus(); } });
</script>

<style>
  .assistant-widget{position:fixed;z-index:30;right:1rem;bottom:max(1rem,env(safe-area-inset-bottom));font:inherit}.assistant-launcher{display:grid;place-items:center;width:3.25rem;height:3.25rem;border:0;border-radius:50%;background:linear-gradient(135deg,#075ca8,#168ee8);color:#fff;font-size:1.35rem;box-shadow:0 10px 26px #075ca84d;cursor:pointer}.assistant-launcher__label{display:grid;place-items:center;color:var(--lime);line-height:1}.assistant-launcher__icon{width:1.45rem;height:1.45rem;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.75}.assistant-widget--open .assistant-launcher__label{color:#fff}.assistant-teaser{position:absolute;right:3.8rem;bottom:.25rem;width:max-content;max-width:14rem;padding:.65rem .8rem;border:1px solid #b6dcfa;border-radius:.75rem;background:#fff;color:#133452;font-size:.82rem;line-height:1.3;box-shadow:0 8px 22px #082f5a2e}.assistant-teaser::after{position:absolute;right:-.42rem;bottom:.72rem;width:.72rem;height:.72rem;border-top:1px solid #b6dcfa;border-right:1px solid #b6dcfa;background:#fff;content:'';transform:rotate(45deg)}.assistant-teaser[hidden],.assistant-panel[hidden]{display:none!important}.assistant-panel{position:absolute;right:0;bottom:3.75rem;display:flex;flex-direction:column;width:min(23rem,calc(100vw - 2rem));max-height:calc(100svh - 1.5rem);overflow:hidden;border:1px solid #b6dcfa;border-radius:1rem;background:#f7fbff;color:#102e4b;box-shadow:0 18px 50px #082f5a40}.assistant-panel header{position:static;z-index:auto;inset:auto;display:flex;height:auto;align-items:flex-start;justify-content:space-between;padding:1rem;background:linear-gradient(135deg,#075ca8,#168ee8);color:#fff}.assistant-panel header p{margin:0;color:#d8f1ff;font-size:.7rem;font-weight:700;letter-spacing:.1em}.assistant-panel h2{margin:.15rem 0;font:600 1.15rem/1.1 var(--sans);letter-spacing:0}.assistant-panel header span,.assistant-note{font-size:.75rem;color:#dcefff}.assistant-close{display:grid;flex:none;width:44px;min-height:44px;place-items:center;border:0;background:transparent;color:inherit;font-size:1.75rem;line-height:1;cursor:pointer}.assistant-messages{min-height:0;max-height:19rem;overflow:auto;padding:1rem;display:grid;gap:.8rem;background:#edf7ff}.assistant-message{width:fit-content;max-width:88%;padding:.65rem .8rem;border-radius:.8rem;font-size:.9rem;line-height:1.45;white-space:pre-wrap}.assistant-message::before{display:block;margin-bottom:.28rem;font-size:.67rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.assistant-message--assistant{justify-self:start;border:1px solid #c8e4f8;background:#fff;color:#133452;border-bottom-left-radius:.2rem}.assistant-message--assistant::before{content:'Francesco';color:#0874d1}.assistant-message--user{justify-self:end;background:#0874d1;color:#fff;border-bottom-right-radius:.2rem}.assistant-message--user::before{content:'Tu';color:#d8f1ff}.assistant-form{display:flex;gap:.5rem;padding:.8rem 1rem;border-top:1px solid #c8e4f8;background:#fff}.assistant-form textarea{min-width:0;flex:1;resize:vertical;border:1px solid #8dc6ef;border-radius:.55rem;background:#fff;color:#102e4b;padding:.55rem;font:inherit}.assistant-form textarea:focus{outline:3px solid #9ed9ff;outline-offset:1px}.assistant-form button{min-height:44px;border:0;border-radius:.55rem;background:#0874d1;color:#fff;padding:.55rem .8rem;font-weight:700;cursor:pointer}.assistant-form button:disabled{opacity:.65;cursor:wait}.assistant-note{margin:0;padding:0 1rem 1rem;background:#fff;color:#49647d}.assistant-note a{color:#075ca8;font-weight:700}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:680px){.assistant-widget{right:.75rem;bottom:max(.75rem,env(safe-area-inset-bottom))}.assistant-widget--open{z-index:1001}.assistant-widget--open .assistant-launcher{position:fixed!important;top:max(.75rem,env(safe-area-inset-top))!important;right:3.5rem!important;bottom:auto!important;z-index:1002!important;width:2.75rem;height:2.75rem;border:1px solid #ffffff8a;background:transparent;box-shadow:none;font-size:1.9rem}.assistant-teaser{right:3.55rem;bottom:.15rem;max-width:11.5rem}.assistant-panel{position:fixed;z-index:1001;inset:0;width:100vw;max-height:100dvh;border:0;border-radius:0;box-shadow:none}.assistant-panel header{padding:max(1rem,env(safe-area-inset-top)) max(1rem,env(safe-area-inset-right)) 1rem max(1rem,env(safe-area-inset-left))}.assistant-close{padding:.1rem .4rem;font-size:2rem}.assistant-messages{flex:1;max-height:none;padding:1rem}.assistant-form{padding:.75rem 1rem}.assistant-note{padding:0 1rem max(1rem,env(safe-area-inset-bottom));}.assistant-launcher{position:relative;z-index:1002}}
</style>
