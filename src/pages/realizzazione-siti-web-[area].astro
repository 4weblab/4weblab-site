---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';
import { areas } from '../config/zones';

export function getStaticPaths() { return Object.entries(areas).map(([area, zone]) => ({ params: { area }, props: { zone, area } })); }
const { zone, area } = Astro.props;
const pageUrl = `${SITE.url}/realizzazione-siti-web-${area}`;
const faqs = zone.faqs;
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Zone servite', item: `${SITE.url}/zone-servite` }, { '@type': 'ListItem', position: 3, name: `Siti web a ${zone.name}`, item: pageUrl }] },
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: `Realizzazione siti web a ${zone.name}`, description: `Progettazione e realizzazione di siti web per ${zone.territory}.`, serviceType: 'Realizzazione siti web', provider: { '@id': `${SITE.url}/#business` }, areaServed: { '@type': 'City', name: zone.name }, url: pageUrl, inLanguage: 'it-IT' },
  { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title={zone.title} description={zone.description} image={`/images/og/realizzazione-siti-web-${area}.webp`} structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="/contatti" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Zone servite', href: '/zone-servite' }, { label: `Siti web a ${zone.name}` }]} /></div></div>
  <section class="local-hero"><div class="wrap"><p class="hero-location">Siti web · {zone.territory}</p><h1>{zone.heroTitle}</h1><p class="lead">{zone.heroLead}</p><div class="actions"><a class="button" href="/contatti">Parliamo del progetto →</a><a class="plain light" href="#cosa-serve">Cosa serve davvero ↓</a></div></div></section>
  <section class="section wrap local-intro"><div><p class="eyebrow">Lavorare sul territorio</p><h2>{zone.territoryHeading}</h2></div><div><p class="statement">Un sito locale non è una pagina con il nome della città ripetuto. È un percorso utile a chi deve capire cosa fai, dove lavori e perché dovrebbe contattarti.</p><p>{zone.detail}</p><p class="context-link">Se il sito attuale esiste già ma non porta richieste, la prima scelta può essere una <a href="/perizia-sito-web">perizia tecnica del sito</a>: separa un problema di visibilità da uno di struttura o conversione.</p></div></section>
  <section id="cosa-serve" class="local-needs"><div class="local-needs-grid"><div class="local-needs-heading"><p class="eyebrow">Cosa deve fare</p><h2>Essere utile<br />prima ancora<br /><em>di essere bello.</em></h2></div><div class="local-needs-copy"><p>{zone.benefitIntro}</p></div><div class="local-needs-points">{zone.benefits.map((benefit, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div></div></section>
  <section class="section wrap local-audience"><div><p class="eyebrow">Per chi è</p><h2>A {zone.name},<br />per chi vuole<br /><em>fare chiarezza.</em></h2></div><div class="local-audience-list">{zone.audience.map((item, index) => <article><small>{String(index + 1).padStart(2, '0')}</small><h3>{item}</h3><p>Un progetto costruito sul modo in cui clienti e potenziali contatti valutano il tuo lavoro prima di scriverti.</p></article>)}</div></section>
  <section class="local-faq section wrap"><div><p class="eyebrow">Domande frequenti</p><h2>Prima di<br /><em>partire.</em></h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
  <section class="local-cta"><div class="wrap"><div><p class="eyebrow light">{zone.territory}</p><h2>Parliamo del<br />sito che deve<br /><em>lavorare per te.</em></h2></div><div><p>Raccontaci attività, obiettivo e pubblico. Ti aiutiamo a capire da quale struttura partire, senza pacchetti standard.</p><div class="actions"><a class="button" href="/contatti">Richiedi un confronto →</a><a class="plain lime" href="/zone-servite">Tutte le zone →</a></div></div></div></section>
</main><SiteFooter />
</body></html>
