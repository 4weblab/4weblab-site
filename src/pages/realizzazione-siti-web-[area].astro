---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';
import { areas, localEditorial } from '../config/zones';

export function getStaticPaths() { return Object.entries(areas).map(([area, zone]) => ({ params: { area }, props: { zone, area } })); }
const { zone, area } = Astro.props;
const pageUrl = `${SITE.url}/realizzazione-siti-web-${area}`;
const faqs = zone.faqs;
const editorial = localEditorial[area as keyof typeof localEditorial];
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Zone servite', item: `${SITE.url}/zone-servite` }, { '@type': 'ListItem', position: 3, name: `Siti web a ${zone.name}`, item: pageUrl }] },
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: `Realizzazione siti web a ${zone.name}`, description: `Progettazione e realizzazione di siti web per ${zone.territory}.`, serviceType: 'Realizzazione siti web', provider: { '@id': `${SITE.url}/#business` }, areaServed: { '@type': 'City', name: zone.name }, url: pageUrl, inLanguage: 'it-IT' },
  { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title={zone.title} description={zone.description} image={`/images/og/realizzazione-siti-web-${area}.webp`} structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="/contatti" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Zone servite', href: '/zone-servite' }, { label: `Siti web a ${zone.name}` }]} /></div></div>
  <section class="local-hero"><div class="wrap"><p class="hero-location">REALIZZAZIONE SITI WEB · {zone.territory}</p><h1>{zone.heroTitle}</h1><p class="lead">{zone.heroLead}</p><div class="actions"><a class="button" href="/contatti">Parliamo del progetto →</a><a class="plain light" href="#cosa-serve">Cosa serve davvero ↓</a></div></div></section>
  <section class="section wrap local-intro"><div><p class="eyebrow">PRIMA DEL CONTATTO</p><h2>{zone.territoryHeading}</h2></div><div><p class="statement">{editorial.statement}</p><p>{zone.detail}</p><p class="context-link">{editorial.audit.before}<a href="/perizia-sito-web">{editorial.audit.anchor}</a>{editorial.audit.after}</p></div></section>
  <section id="cosa-serve" class="local-needs"><div class="local-needs-grid"><div class="local-needs-heading"><p class="eyebrow">LA STRUTTURA CHE SERVE</p><h2>Essere utile<br />prima ancora<br /><em>di essere bello.</em></h2></div><div class="local-needs-copy"><p>{zone.benefitIntro}</p></div><div class="local-needs-points">{zone.benefits.map((benefit, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div></div></section>
  {zone.continuity && <section class="local-continuity section wrap"><div><p class="eyebrow">{zone.continuity.eyebrow}</p><h2>{zone.continuity.title}<br /><em>{zone.continuity.emphasis}</em></h2></div><div class="local-continuity-content"><p class="statement">{zone.continuity.lead}</p><div class="local-continuity-steps">{zone.continuity.steps.map((step, index) => <article><small>{String(index + 1).padStart(2, '0')}</small><h3>{step.title}</h3><p>{step.text}</p></article>)}</div><p class="local-continuity-support">{zone.continuity.support}</p><p class="context-link">{zone.continuity.proof.before}<a href={zone.continuity.proof.href}>{zone.continuity.proof.anchor}</a>{zone.continuity.proof.after}</p></div></section>}
  <section class="section wrap local-audience"><div><p class="eyebrow">PER CHI DEVE SCEGLIERVI</p><h2>{zone.name === 'Albignasego' || zone.name === 'Abano Terme' ? 'Ad' : 'A'} {zone.name},<br />per chi vuole<br /><em>fare chiarezza.</em></h2></div><div class="local-audience-list">{zone.audience.map((item, index) => <article><small>{String(index + 1).padStart(2, '0')}</small><h3>{item}</h3><p>{editorial.audienceDescriptions[index]}</p></article>)}</div></section>
  <section class="local-faq section wrap"><div><p class="eyebrow">DOMANDE FREQUENTI</p><h2>Prima di<br /><em>partire.</em></h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
  <section class="local-cta"><div class="wrap"><div><p class="eyebrow light">{zone.territory}</p><h2>Parliamo del<br />sito che deve<br /><em>lavorare per te.</em></h2></div><div><p>Raccontaci attività, obiettivo e pubblico. Ti aiutiamo a capire da quale struttura partire, senza pacchetti standard.</p><div class="actions"><a class="button" href="/contatti">Richiedi un confronto →</a><a class="plain lime" href="/zone-servite">Tutte le zone →</a></div></div></div></section>
</main><SiteFooter />
</body></html>
