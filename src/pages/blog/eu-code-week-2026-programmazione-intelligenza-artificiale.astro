] }];
---

<!doctype html>
<html lang="it">
  <head>
    <SeoHead title={`${title} | 4 Web Lab`} description={description} image={image} type="article" structuredData={structuredData} />
    <meta property="article:published_time" content="2026-10-09" />
    <meta property="article:modified_time" content="2026-10-09" />
