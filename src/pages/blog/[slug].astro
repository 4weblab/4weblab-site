---
import '../../styles/global.css';
import SeoHead from '../../components/SeoHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE } from '../../config/site';
import { blogArticles, formatArticleDate, getArticleSeoTitle, getArticleVisual } from '../../config/blog';
import { blogSupplements, expandedBlogContent } from '../../config/blog-expanded';
import { articleInterlinks, getArticleModified } from '../../config/blog-interlinks';

export function getStaticPaths() {
  const customArticleSlugs = new Set(['guida-wordpress-alternative-2026', 'eu-code-week-2026-programmazione-intelligenza-artificiale']);
  return blogArticles.filter((article) => !customArticleSlugs.has(article.slug)).map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const h1Title = article.h1Title ?? article.title;
const expanded = expandedBlogContent[article.slug];
const visual = getArticleVisual(article);
const seoTitle = getArticleSeoTitle(article);
const modified = getArticleModified(article.slug, article.modified);
const interlinks = articleInterlinks[article.slug];
const pageUrl = `${SITE.url}/blog/${article.slug}`;
const allSections = [...expanded.sections, blogSupplements[article.slug]];
const wordCount = [article.intro, expanded.kicker, ...allSections.map((section) => section.paragraphs), ...article.faqs.map((faq) => faq[1])].flat().join(' ').trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 180));
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` }, { '@type': 'ListItem', position: 3, name: h1Title, item: pageUrl }] },
  { '@type': 'BlogPosting', '@id': `${pageUrl}#article`, headline: h1Title, description: article.description, image: [`${SITE.url}${visual.image}`], url: pageUrl, mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl }, datePublished: article.published, dateModified: modified, articleSection: article.category, inLanguage: 'it-IT', wordCount, author: { '@type': 'Person', name: 'Carlo Fullin', url: SITE.url }, publisher: { '@id': `${SITE.url}/#business` } },
  { '@type': 'FAQPage', mainEntity: article.faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---
<!doctype html>
<html lang="it">
  <head>
    <SeoHead title={`${seoTitle} | 4 Web Lab`} description={article.description} image={visual.image} type="article" structuredData={structuredData} />
    <meta property="article:published_time" content={article.published} />
    <meta property="article:modified_time" content={modified} />
    <meta property="article:section" content={article.category} />
    <meta property="article:author" content="Carlo Fullin" />
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <SiteHeader contactTarget="/contatti" />
    <main id="contenuto">
      <article class="article-linear">
        <header class="article-linear-header">
          <div class="wrap">
            <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><span aria-current="page">{h1Title}</span></nav>
            <p class="eyebrow light">{article.category}</p>
            <h1>{h1Title}</h1>
            <p class="article-linear-meta">Pubblicato il {formatArticleDate(article.published)} · Aggiornato il {formatArticleDate(modified)} · {readingTime} min di lettura</p>
          </div>
        </header>
        <div class="article-linear-body">
          <p class="article-kicker">{expanded.kicker}</p>
          {article.intro.map((paragraph) => <p>{paragraph}</p>)}
          {allSections.map((section) => <section><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
          {interlinks.map((link) => <p class="article-interlink">{link.before}<a href={link.href}>{link.anchor}</a>{link.after}</p>)}
          <h2>Domande frequenti</h2>
          {article.faqs.map(([question, answer]) => <section class="article-linear-faq"><h3>{question}</h3><p>{answer}</p></section>)}
        </div>
      </article>
    </main>
    <SiteFooter />
  </body>
</html>
