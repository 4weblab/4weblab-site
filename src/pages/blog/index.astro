---
import '../../styles/global.css';
import SeoHead from '../../components/SeoHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { blogArticles, formatArticleDate, getArticleVisual } from '../../config/blog';
import { getArticleModified } from '../../config/blog-interlinks';

const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` }] },
  { '@type': 'Blog', '@id': `${SITE.url}/blog#blog`, name: 'Blog 4 Web Lab', url: `${SITE.url}/blog`, inLanguage: 'it-IT', publisher: { '@id': `${SITE.url}/#business` }, blogPost: blogArticles.map((article) => ({ '@type': 'BlogPosting', headline: article.title, description: article.description, url: `${SITE.url}/blog/${article.slug}`, image: `${SITE.url}${getArticleVisual(article).image}`, datePublished: article.published, dateModified: getArticleModified(article.slug, article.modified) })) },
] }];
---
<!doctype html><html lang="it"><head><SeoHead title="Blog: siti web, SEO, costi e AI | 4 Web Lab" description="Guide pratiche su siti web, SEO, costi, GDPR e intelligenza artificiale per attività, professionisti e PMI." image="/images/og/home.webp" structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="/contatti" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} /></div></div>
  <section class="blog-hub-hero"><div class="wrap"><p class="eyebrow light">Blog 4 Web Lab</p><h1>Guide pratiche su siti web,<br /><em>SEO e intelligenza artificiale.</em></h1><p class="lead">Risposte concrete per capire se rifare un sito, come valutarne costi e visibilità e quando l’intelligenza artificiale può aiutare davvero.</p></div></section>
  <section class="blog-index" aria-labelledby="articoli"><div class="blog-index-grid"><div class="blog-index-heading"><p class="eyebrow">Prima di scegliere</p><h2 id="articoli">Capire prima.<br /><em>Scegliere meglio.</em></h2><p>Qui trovi risposte alle domande che arrivano prima di un progetto: quanto costa un sito, perché non si trova su Google, cosa comportano privacy e strumenti fai-da-te e dove l’intelligenza artificiale può essere utile. Ogni articolo parte da un problema concreto e indica cosa controllare prima di decidere.</p></div><div class="blog-card-grid">{blogArticles.map((article) => { const visual = getArticleVisual(article); return <article><a href={`/blog/${article.slug}`}><img src={visual.image} alt={visual.alt} width="1536" height="1024" loading="lazy" /><div><p class="blog-card-meta">{article.category} · {formatArticleDate(article.published)}</p><h3>{article.title}</h3><p>{article.excerpt}</p><span>Leggi l’articolo →</span></div></a></article>; })}</div></div></section>
  <section class="blog-hub-cta"><div class="wrap"><div><p class="eyebrow light">Hai un dubbio sul tuo sito?</p><h2>Partiamo da ciò<br />che non <em>funziona.</em></h2></div><div><p>Se il sito esiste già ma non sai da dove iniziare, una perizia tecnica aiuta a separare i problemi di struttura, visibilità e percorso verso il contatto prima di rifarlo.</p><a class="button" href="/perizia-sito-web">Scopri la perizia →</a></div></div></section>
</main><SiteFooter />
</body></html>
