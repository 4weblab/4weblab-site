---
import '../styles/global.css';

const promoCode = 'SCONTO PROMO ELITRAINER';
const promoDeadline = '2026-11-06T12:00:00+01:00';
const plans = [
  {
    id: 'negozio',
    number: '01',
    audience: 'Per negozi e attività locali',
    title: 'Il tuo negozio\nsi fa trovare.',
    image: '/images/negozi-storefront.webp',
    alt: 'Vetrina di un negozio',
    original: '490 €',
    price: '343 €',
    features: ['Design e struttura del sito', 'Versione mobile', 'Ottimizzazione tecnica di base', 'Inserimento dei contenuti iniziali', '3 mesi di hosting inclusi*'],
  },
  {
    id: 'professionista',
    number: '02',
    audience: 'Per professionisti e studi',
    title: 'Fai capire\nquanto vali.',
    image: '/images/professionista.webp',
    alt: 'Professionista al lavoro',
    original: '990 €',
    price: '693 €',
    features: ['Design su misura', 'Fino a 3 pagine iniziali', 'Versione mobile', 'Base SEO on-page', 'Form e contatti diretti'],
  },
  {
    id: 'azienda',
    number: '03',
    audience: 'Per aziende e PMI',
    title: 'Metti ordine\nalla tua crescita.',
    image: '/images/aziendali-mockup.webp',
    alt: 'Mockup di un sito web aziendale',
    original: '1.890 €',
    price: '1.323 €',
    features: ['Architettura multipagina', 'Design dedicato e versione mobile', 'Base SEO tecnica e on-page', 'Form, contatti e tracciamenti essenziali', 'Pubblicazione e passaggio di consegne'],
  },
  {
    id: 'app',
    number: '04',
    audience: 'Per professionisti e studi di settore',
    title: 'Porta il tuo\nservizio in app.',
    alt: 'Anteprima grafica di un’app personalizzata',
    custom: true,
    features: ['Analisi del flusso di lavoro', 'Interfaccia progettata su misura', 'Funzioni pensate per il tuo servizio', 'Versione mobile e responsive', 'Sviluppo con perimetro concordato'],
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <title>30% di sconto su siti e app personalizzate · Collaborazione di lancio</title>
  </head>
  <body class="promo-page">
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <header class="promo-header">
      <div class="promo-nav wrap">
        <a class="promo-brand" href="/" aria-label="4 Web Lab, home"><img src="/4weblab-logo-header.svg" width="240" height="88" alt="4 Web Lab" /></a>
        <nav class="promo-desktop-nav" aria-label="Navigazione della landing">
          <a href="#offerta">L'offerta</a>
          <a href="#come-funziona">Come funziona</a>
          <a href="#richiedi">Richiedi</a>
        </nav>
        <div class="promo-nav-actions">
          <a class="promo-top-cta" href="#richiedi">Blocca il 30%</a>
          <details class="promo-mobile-menu">
            <summary aria-label="Apri il menu"><span aria-hidden="true"></span><span class="sr-only">Apri il menu</span></summary>
            <div class="promo-mobile-panel">
              <a href="#offerta">L'offerta</a>
              <a href="#come-funziona">Come funziona</a>
              <a href="#richiedi">Richiedi</a>
              <a class="promo-mobile-whatsapp" href="https://wa.me/393514656042">Scrivici su WhatsApp ↗</a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="contenuto">
      <section class="promo-hero">
        <div class="promo-hero-noise" aria-hidden="true"></div>
        <div class="wrap promo-hero-grid">
          <div class="promo-hero-copy">
            <p class="promo-kicker">COLLABORAZIONE DI LANCIO · FINO AL 6 NOVEMBRE, ORE 12:00</p>
            <h1>Il tuo prossimo progetto<br /><em>parte con il 30% in meno.</em></h1>
            <p class="promo-hero-lead">Il nuovo sito di Elisa e del suo Team EP è online. Per festeggiare il lancio, apro una collaborazione speciale: fino al 6 novembre alle ore 12:00 puoi scegliere il progetto digitale giusto per la tua attività e bloccare il prezzo promozionale.</p>
            <div class="promo-actions">
              <a class="promo-button" href="#offerta">Scegli il tuo pacchetto ↓</a>
              <a class="promo-text-link" href="https://wa.me/393514656042">Parliamone su WhatsApp ↗</a>
            </div>
            <p class="promo-microcopy">Quattro soluzioni. Un prezzo trasparente. Una scadenza vera.</p>
            <aside class="promo-countdown" data-deadline={promoDeadline} aria-label="Tempo rimanente alla scadenza della promo">
              <p class="promo-countdown-label">Tempo rimasto</p>
              <div class="promo-countdown-values" role="timer" aria-label="Conto alla rovescia">
                <span><strong data-countdown-days>--</strong><small>gg</small></span>
                <b aria-hidden="true">:</b>
                <span><strong data-countdown-hours>--</strong><small>hh</small></span>
                <b aria-hidden="true">:</b>
                <span><strong data-countdown-minutes>--</strong><small>mm</small></span>
                <b aria-hidden="true">:</b>
                <span><strong data-countdown-seconds>--</strong><small>ss</small></span>
              </div>
              <p class="promo-countdown-note">La promo termina il 6 novembre alle ore 12:00.</p>
              <p class="sr-only" data-countdown-status aria-live="polite"></p>
            </aside>
          </div>
          <div class="promo-hero-visual">
            <div class="promo-sticker"><strong>-30%</strong><span>fino al<br />6 novembre · ore 12</span></div>
            <figure class="promo-hero-image"><img src="/images/promo-elitrainer-hero-v2.webp" width="1672" height="940" alt="Pagina web che prende forma in una composizione luminosa" fetchpriority="high" /></figure>
            <div class="promo-hero-caption"><span>NUOVO PROGETTO · NUOVA PRESENZA</span><strong>Adesso tocca al tuo.</strong></div>
          </div>
        </div>
      </section>

      <section class="promo-intro" aria-labelledby="promo-intro-title">
        <div class="wrap promo-intro-grid">
          <div>
            <p class="promo-label">Una collaborazione, non un codice sconto</p>
            <h2 id="promo-intro-title">Il progetto che ti serve.<br /><em>Al momento giusto.</em></h2>
          </div>
          <div class="promo-intro-copy">
            <p class="promo-big-copy">Un progetto digitale non è un vezzo: è il punto in cui una persona decide se fidarsi, chiamare o chiedere un preventivo.</p>
            <p>Per questo ho raccolto quattro partenze chiare. Negozi, professionisti, aziende e studi di settore hanno bisogni diversi: scegli la tua, compila il form e ti ricontatto con il perimetro giusto del progetto.</p>
            <a class="promo-arrow-link" href="#richiedi">Voglio partire con il 30% →</a>
          </div>
        </div>
      </section>

      <section id="offerta" class="promo-offer" aria-labelledby="offerta-title">
        <div class="wrap">
          <div class="promo-section-heading">
            <div>
              <p class="promo-label">L'offerta di lancio</p>
              <h2 id="offerta-title">Quattro modi per<br /><em>farti scegliere.</em></h2>
            </div>
            <p>Per i primi tre percorsi trovi il prezzo di partenza già scontato. Per un’app personalizzata definiamo insieme il progetto e applichiamo il 30% di sconto al preventivo promo, per richieste ricevute entro il 6 novembre alle ore 12:00.</p>
          </div>
          <div class="promo-plan-list">
            {plans.map((plan) => (
              <article class:list={['promo-plan', `promo-plan-${plan.id}`]}>
                <div class="promo-plan-visual">
                  {plan.custom ? (
                    <div class="promo-app-visual-art" aria-hidden="true">
                      <div class="promo-app-device">
                        <div class="promo-app-screen">
                          <span>AREA RISERVATA</span>
                          <strong>Il tuo servizio,<br />sempre con te.</strong>
                          <div class="promo-app-lines"><i></i><i></i><i></i></div>
                          <b>+</b>
                        </div>
                      </div>
                    </div>
                  ) : (
                    <img src={plan.image} width="1280" height="960" loading="lazy" alt={plan.alt} />
                  )}
                  <span>{plan.number}</span>
                </div>
                <div class="promo-plan-body">
                  <p class="promo-plan-audience">{plan.audience}</p>
                  <h3>{plan.title.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</h3>
                  <ul>{plan.features.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul>
                  <div class="promo-plan-footer">
                    {plan.custom ? (
                      <div class="promo-custom-price"><strong>Su progetto</strong><span>30% di sconto promo</span></div>
                    ) : (
                      <div class="promo-price"><del>{plan.original}</del><strong>{plan.price}</strong><span>+ IVA</span></div>
                    )}
                    <a class="promo-small-cta" href="#richiedi">{plan.custom ? 'Parliamone →' : 'Voglio questo →'}</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <p class="promo-offer-note">* Per il pacchetto negozio sono inclusi 3 mesi di hosting; dal quarto mese l'hosting è 99 € / anno + IVA. Eventuali extra vengono sempre concordati prima.</p>
        </div>
      </section>

      <section id="come-funziona" class="promo-process" aria-labelledby="process-title">
        <div class="wrap promo-process-grid">
          <div>
            <p class="promo-label">Semplice, dall'inizio alla fine</p>
            <h2 id="process-title">Tu porti<br /><em>l'idea.</em></h2>
            <p class="promo-process-lead">Io la trasformo in una presenza online che sa dove portare le persone.</p>
          </div>
          <div class="promo-steps">
            <article><span>01</span><div><h3>Mi racconti cosa fai</h3><p>Compili il form o mi scrivi su WhatsApp. Bastano attività, obiettivo e contatti.</p></div></article>
            <article><span>02</span><div><h3>Inquadriamo il progetto</h3><p>Ti restituisco il pacchetto più adatto, cosa comprende e il prezzo già scontato.</p></div></article>
            <article><span>03</span><div><h3>Partiamo con il tuo nuovo progetto</h3><p>Blocchi la collaborazione entro il 6 novembre alle ore 12:00 e diamo forma al prossimo passo.</p></div></article>
          </div>
        </div>
      </section>

      <section class="promo-proof" aria-labelledby="proof-title">
        <div class="wrap promo-proof-grid">
          <div class="promo-proof-image"><img src="/images/negozi-mobile-search.webp" width="1280" height="960" loading="lazy" alt="Sito web consultato da smartphone" /><span>Dal social<br />alla scelta.</span></div>
          <div>
            <p class="promo-label">Perché questa occasione</p>
            <h2 id="proof-title">Il lancio è adesso.<br /><em>Il tuo turno anche.</em></h2>
            <p class="promo-big-copy">Una persona può arrivare da un post, da un passaparola o da una ricerca. Quando arriva, il tuo progetto digitale deve fare il resto: spiegare, rassicurare e rendere semplice il contatto.</p>
            <p>Questa collaborazione nasce per dare a più attività una partenza concreta, con un investimento più leggero e un progetto pensato sul loro modo di lavorare.</p>
            <a class="promo-arrow-link" href="#richiedi">Raccontami il tuo progetto →</a>
          </div>
        </div>
      </section>

      <section id="richiedi" class="promo-contact" aria-labelledby="contact-title">
        <div class="wrap promo-contact-grid">
          <div class="promo-contact-copy">
            <p class="promo-label">Richiedi il tuo preventivo</p>
            <h2 id="contact-title">Il prossimo<br />progetto è<br /><em>questo.</em></h2>
            <p>Compila il form: ti rispondo con il percorso più adatto e, per le app personalizzate, con un preventivo promo già scontato. Se preferisci parlare subito, scrivimi su WhatsApp.</p>
            <a class="promo-whatsapp" href="https://wa.me/393514656042"><span>CONTATTO DIRETTO</span><strong>Scrivimi su WhatsApp ↗</strong><small>Risposta rapida, senza impegno</small></a>
          </div>
          <form id="promo-elitrainer-form" class="promo-form" method="post" action="https://api.web3forms.com/submit">
            <input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" />
            <input type="hidden" name="subject" value="Richiesta promo Elitrainer - 30% sito o app" />
            <input type="hidden" name="source_page" value="promo-elitrainer" />
            <label>Nome *<input name="name" required autocomplete="name" /></label>
            <label>Email *<input name="email" type="email" required autocomplete="email" /></label>
            <label>Telefono<input name="phone" type="tel" autocomplete="tel" /></label>
            <label>Quale progetto ti interessa? *<select name="service" required><option value="" selected disabled>Scegli una soluzione</option><option value="Sito per negozio - 343 euro + IVA">Sito per negozio · 343 € + IVA</option><option value="Sito per professionista - 693 euro + IVA">Sito per professionista · 693 € + IVA</option><option value="Sito web aziendale - 1323 euro + IVA">Sito web aziendale · 1.323 € + IVA</option><option value="App personalizzata per professionista o studio - preventivo su progetto con 30% promo">App personalizzata per professionista o studio · preventivo su progetto, 30% promo</option><option value="Non so ancora, vorrei un consiglio">Non so ancora, vorrei un consiglio</option></select></label>
            <label>Raccontami cosa vuoi ottenere *<textarea name="message" required rows="4"></textarea></label>
            <label class="promo-code-label">Codice promozionale<input name="promo_code" value={promoCode} readonly aria-readonly="true" /></label>
            <label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
            <button class="promo-button promo-submit" type="submit">Richiedi il preventivo →</button>
            <p class="promo-privacy">La richiesta non ti obbliga ad acquistare. I dati servono solo per ricontattarti.</p>
            <p id="promo-elitrainer-status" class="promo-form-status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="promo-footer"><div class="wrap"><span>© 4 Web Lab · Collaborazione di lancio</span><span>Promo valida per richieste ricevute entro il 6 novembre alle ore 12:00.</span></div></footer>

    <script is:inline>
      const countdown = document.querySelector('[data-deadline]');
      const countdownValues = {
        days: countdown?.querySelector('[data-countdown-days]'),
        hours: countdown?.querySelector('[data-countdown-hours]'),
        minutes: countdown?.querySelector('[data-countdown-minutes]'),
        seconds: countdown?.querySelector('[data-countdown-seconds]'),
      };
      const countdownStatus = countdown?.querySelector('[data-countdown-status]');
      const deadline = countdown ? new Date(countdown.dataset.deadline).getTime() : NaN;
      let lastAnnouncedMinute = '';
      let countdownInterval;

      const updateCountdown = () => {
        if (!countdown || !Number.isFinite(deadline)) return;
        const remainingSeconds = Math.max(0, Math.floor((deadline - Date.now()) / 1000));
        const days = Math.floor(remainingSeconds / 86400);
        const hours = Math.floor((remainingSeconds % 86400) / 3600);
        const minutes = Math.floor((remainingSeconds % 3600) / 60);
        const seconds = remainingSeconds % 60;
        const pad = (value) => String(value).padStart(2, '0');

        countdownValues.days.textContent = pad(days);
        countdownValues.hours.textContent = pad(hours);
        countdownValues.minutes.textContent = pad(minutes);
        countdownValues.seconds.textContent = pad(seconds);

        if (remainingSeconds === 0) {
          countdown.dataset.expired = 'true';
          countdownStatus.textContent = 'La promo è terminata.';
          window.clearInterval(countdownInterval);
          return;
        }

        const minuteAnnouncement = `${days}:${hours}:${minutes}`;
        if (minuteAnnouncement !== lastAnnouncedMinute) {
          countdownStatus.textContent = `Mancano ${days} giorni, ${hours} ore e ${minutes} minuti alla scadenza della promo.`;
          lastAnnouncedMinute = minuteAnnouncement;
        }
      };

      updateCountdown();
      countdownInterval = window.setInterval(updateCountdown, 1000);

      const promoForm = document.querySelector('#promo-elitrainer-form');
      const promoStatus = document.querySelector('#promo-elitrainer-status');
      promoForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (promoForm.website.value) return;
        const button = promoForm.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = 'Invio in corso…';
        promoStatus.textContent = '';
        try {
          const response = await fetch(promoForm.action, { method: 'POST', body: new FormData(promoForm) });
          const data = await response.json();
          if (!response.ok || !data.success) throw new Error('send');
          promoForm.reset();
          promoForm.promo_code.value = 'SCONTO PROMO ELITRAINER';
          promoStatus.textContent = 'Richiesta inviata. Ti rispondo entro 24 ore lavorative.';
        } catch {
          promoStatus.textContent = 'Invio non riuscito. Riprova tra poco o scrivimi su WhatsApp.';
        } finally {
          button.disabled = false;
          button.textContent = 'Richiedi il preventivo →';
        }
      });
      document.querySelectorAll('.promo-mobile-panel a').forEach((link) => link.addEventListener('click', () => { link.closest('details')?.removeAttribute('open'); }));
    </script>

    <style>
      .promo-page { --promo-coral: #ff674d; --promo-yellow: var(--lime); --promo-surface: #18233b; --promo-line: rgb(255 255 255 / .2); background: #f5f3ed; color: var(--ink); }
      .promo-page html { scroll-padding-top: 78px; }
      .promo-page .skip:focus { z-index: 300; }
      .promo-header { position: sticky; top: 0; z-index: 200; height: 78px; padding: 0 max(22px, calc((100vw - 1220px) / 2)); border-bottom: 1px solid rgb(255 255 255 / .14); background: rgb(16 26 45 / .96); color: #fff; backdrop-filter: blur(14px); }
      .promo-nav { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
      .promo-brand { display: block; flex: 0 0 auto; color: #fff; }
      .promo-brand img { display: block; width: 102px; height: auto; }
      .promo-desktop-nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 42px); margin-left: auto; }
      .promo-desktop-nav a { color: #eaf0f7; font-size: 14px; font-weight: 700; text-decoration: none; }
      .promo-desktop-nav a:hover, .promo-desktop-nav a:focus-visible { color: var(--promo-yellow); }
      .promo-nav-actions { display: flex; align-items: center; gap: 10px; }
      .promo-top-cta, .promo-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 13px 18px; border: 1px solid var(--promo-yellow); background: var(--promo-yellow); color: var(--ink); font: 700 13px/1 var(--sans); text-decoration: none; transition: transform .2s var(--ease-out), background .2s var(--ease-out), color .2s var(--ease-out); }
      .promo-top-cta:hover, .promo-button:hover { transform: translateY(-2px); background: #fff; color: var(--ink); }
      .promo-mobile-menu { display: none; position: relative; }
      .promo-mobile-menu summary { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .7); list-style: none; cursor: pointer; }
      .promo-mobile-menu summary::-webkit-details-marker { display: none; }
      .promo-mobile-menu summary > span:first-child, .promo-mobile-menu summary > span:first-child::before, .promo-mobile-menu summary > span:first-child::after { width: 19px; height: 2px; display: block; background: #fff; }
      .promo-mobile-menu summary > span:first-child { position: relative; }
      .promo-mobile-menu summary > span:first-child::before, .promo-mobile-menu summary > span:first-child::after { position: absolute; left: 0; content: ''; }
      .promo-mobile-menu summary > span:first-child::before { top: -6px; }.promo-mobile-menu summary > span:first-child::after { top: 6px; }
      .promo-mobile-panel { position: fixed; top: 78px; right: 0; left: 0; display: grid; gap: 0; padding: 18px 22px 30px; border-top: 1px solid var(--promo-line); background: var(--ink); box-shadow: 0 22px 35px rgb(0 0 0 / .25); }
      .promo-mobile-panel a { padding: 14px 0; border-bottom: 1px solid var(--promo-line); color: #fff; font-size: 18px; font-weight: 700; text-decoration: none; }
      .promo-mobile-panel .promo-mobile-whatsapp { color: var(--promo-yellow); }

      .promo-hero { position: relative; min-height: min(820px, calc(100svh - 78px)); display: grid; align-items: center; overflow: hidden; background: var(--ink); color: #fff; }
      .promo-hero::after { position: absolute; right: -11vw; bottom: -20vw; width: 58vw; height: 58vw; border: 1px solid rgb(240 247 74 / .25); border-radius: 50%; content: ''; pointer-events: none; }
      .promo-hero-noise { position: absolute; inset: 0; opacity: .22; background: linear-gradient(120deg, transparent 0 47%, rgb(255 103 77 / .18) 47% 47.4%, transparent 47.4% 100%); pointer-events: none; }
      .promo-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(390px, .78fr); gap: clamp(46px, 8vw, 120px); align-items: center; padding-top: 54px; padding-bottom: 70px; }
      .promo-kicker, .promo-label { margin: 0 0 23px; color: var(--promo-coral); font: 11px/1.4 var(--mono); letter-spacing: .11em; text-transform: uppercase; }
      .promo-page h1, .promo-page h2, .promo-page h3 { font-family: var(--serif); letter-spacing: -.035em; }
      .promo-page h1 { max-width: 11ch; margin: 0; color: #fff; font: 600 clamp(56px, 7.2vw, 104px)/.91 var(--serif); }
      .promo-page h1 em, .promo-page .promo-offer h2 em, .promo-page .promo-contact h2 em { color: var(--promo-yellow) !important; font-style: italic; background: transparent !important; padding: 0 !important; }
      .promo-hero-lead { max-width: 570px; margin: 31px 0 28px; color: #d8e2ef; font-size: clamp(18px, 1.65vw, 22px); line-height: 1.5; }
      .promo-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; }
      .promo-text-link, .promo-arrow-link { color: inherit; font-weight: 700; text-underline-offset: 5px; }
      .promo-text-link { color: #fff; text-decoration: none; border-bottom: 1px solid var(--promo-coral); padding-bottom: 4px; }
      .promo-microcopy { margin: 34px 0 0; color: #9fb1c9; font: 11px var(--mono); letter-spacing: .04em; }
      .promo-countdown { width: fit-content; margin-top: 24px; padding: 16px 18px 14px; border: 1px solid rgb(255 255 255 / .28); background: rgb(24 35 59 / .72); }
      .promo-countdown-label { margin: 0 0 9px; color: var(--promo-yellow); font: 10px/1.3 var(--mono); letter-spacing: .12em; text-transform: uppercase; }
      .promo-countdown-values { display: flex; align-items: baseline; gap: 8px; color: #fff; }
