---
import '../styles/global.css';
import '../styles/chatgpt-ads-service.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import copy from '../data/chatgpt-ads-copy.json';
import { SITE } from '../config/site';

const pageUrl = SITE.url + '/pubblicita-su-chatgpt/';
const contactId = 'contatti-pubblicita-su-chatgpt';
const money = (html: string) => html.replace(/(\d[\d.,]* € \+ IVA)/g, '<span class="cg-money">$1</span>');
const [format, assessment, setup, management, landing] = copy.sections;
const blocks = (html: string) => [...html.matchAll(/<p\b[^>]*>.*?<\/p>|<ul>.*?<\/ul>/gs)].map(match => match[0]);
const setupBlocks = blocks(setup.html);
const managementBlocks = blocks(management.html);
const assessmentParagraphs = [...assessment.html.matchAll(/<p>(.*?)<\/p>/gs)].map(match => match[1]);
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }, { '@type': 'ListItem', position: 2, name: 'ChatGPT Ads', item: pageUrl }] },
  { '@type': 'Service', '@id': pageUrl + '#service', name: copy.h1, description: copy.description, serviceType: 'Consulenza e gestione campagne ChatGPT Ads', provider: { '@id': SITE.url + '/#business' }, areaServed: { '@type': 'Country', name: 'Italia' }, url: pageUrl, inLanguage: 'it-IT', isPartOf: { '@id': SITE.url + '/#website' }, offers: [
    { '@type': 'Offer', name: 'Avvio e primo mese di gestione', url: pageUrl, priceCurrency: 'EUR', description: 'Primo mese dalla pubblicazione della campagna. Budget pubblicitario escluso e pagato direttamente a OpenAI. Landing aggiuntiva separata.', priceSpecification: { '@type': 'PriceSpecification', price: '699', priceCurrency: 'EUR', valueAddedTaxIncluded: false } },
    { '@type': 'Offer', name: 'Gestione dal secondo mese', url: pageUrl, priceCurrency: 'EUR', description: 'Dal secondo mese. Budget pubblicitario escluso e pagato direttamente a OpenAI.', priceSpecification: { '@type': 'UnitPriceSpecification', price: '399', priceCurrency: 'EUR', valueAddedTaxIncluded: false, unitText: 'MONTH' } },
    { '@type': 'Offer', name: 'Landing dedicata alla singola campagna', url: pageUrl, priceCurrency: 'EUR', description: 'Servizio aggiuntivo, non incluso nell’avvio o nella gestione mensile.', priceSpecification: { '@type': 'PriceSpecification', minPrice: '199', priceCurrency: 'EUR', valueAddedTaxIncluded: false } },
  ] },
  { '@type': 'FAQPage', mainEntity: copy.faqs.map(({question, answer}) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
] }];
const privacy = copy.privacy.replace('Leggi l’informativa privacy.', '<a href="/privacy/">Leggi l’informativa privacy.</a>');
---
<!doctype html>
<html lang="it">
  <head><SeoHead title={copy.title} description={copy.description} image="/images/chatgpt-ads-direction-3/og.webp" structuredData={structuredData} /></head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <SiteHeader contactTarget={'#' + contactId} />
    <main id="contenuto" class="chatgpt-direction">
      <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'ChatGPT Ads' }]} /></div></div>
      <section class="cg-hero">
        <div class="wrap cg-hero-grid">
          <div class="cg-hero-copy">
            <p class="hero-location">{copy.eyebrow}</p>
            <h1>{copy.h1}</h1>
            <div class="cg-prose" set:html={money(copy.heroHtml)} />
            <div class="actions"><a class="button" href={'#' + contactId}>{copy.primary}</a><a class="cg-secondary" href="#avvio-chatgpt-ads">{copy.secondary}</a></div>
          </div>
          <figure class="cg-hero-figure">
            <div class="cg-phone-scene">
              <div class="cg-hand" aria-hidden="true"><ResponsiveImage src="/images/chatgpt-ads-direction-3/mano-telefono.webp" width={1200} height={1200} sizes="(max-width: 680px) calc(100vw - 40px), (max-width: 900px) 480px, 48vw" alt="" loading="eager" /></div>
              <div class="cg-phone-screen"><ResponsiveImage src="/images/chatgpt-ads-direction-3/schermo-chatgpt-openai.webp" width={700} height={1473} sizes="(max-width: 680px) 42vw, (max-width: 900px) 200px, 22vw" alt="Esempio ufficiale OpenAI: risposta di ChatGPT seguita da un annuncio HarborWest, separato e riconoscibile come pubblicità." loading="eager" fetchpriority="high" /></div>
            </div>
            <figcaption>Esempio illustrativo · <a href="https://ads.openai.com/">Fonte: OpenAI</a></figcaption>
          </figure>
        </div>
      </section>
      <section id={format.id} class="cg-section cg-format">
        <div class="wrap">
          <h2>{format.title}</h2>
          <div class="cg-format-grid">
            <div class="cg-prose" set:html={format.html} />
            <figure><ResponsiveImage src="/images/chatgpt-ads-direction-3/formato-annuncio-openai.webp" width={481} height={497} sizes="(max-width: 680px) calc(100vw - 40px), 400px" alt="Esempio ufficiale OpenAI di annuncio sponsorizzato Heirloom Groceries, con titolo, descrizione e immagine." /><figcaption>Esempio illustrativo · <a href="https://help.openai.com/en/articles/20001207-ads-in-chatgpt-the-basics">Fonte: OpenAI</a></figcaption></figure>
          </div>
        </div>
      </section>
      <section id={assessment.id} class="cg-section cg-assessment">
        <div class="wrap"><h2>{assessment.title}</h2><div class="cg-assessment-grid">{assessmentParagraphs.map(paragraph => <p set:html={paragraph} />)}</div></div>
      </section>
      <section id={setup.id} class="cg-section cg-setup">
        <div class="wrap">
          <h2 set:html={money(setup.title)} />
          <div class="cg-prose" set:html={setupBlocks.slice(0, 2).join('')} />
          <div class="cg-setup-grid">
            <div class="cg-inclusions" set:html={setupBlocks[2].replace('<ul>', '<ul role="list">')} />
            <figure><ResponsiveImage src="/images/chatgpt-ads-direction-3/ads-manager-openai.webp" width={1200} height={790} sizes="(max-width: 900px) calc(100vw - 40px), 34vw" alt="Interfaccia dimostrativa OpenAI Ads Manager con anteprima di un annuncio Simple Home Designs." /><figcaption>Interfaccia dimostrativa · <a href="https://ads.openai.com/">Fonte: OpenAI</a></figcaption></figure>
          </div>
          <div class="cg-prose cg-setup-notes" set:html={setupBlocks.slice(3).join('')} />
          <a class="button" href={'#' + contactId}>{setup.cta}</a>
        </div>
      </section>
      <section id={management.id} class="cg-section cg-management">
        <div class="wrap">
          <h2 set:html={money(management.title)} />
          <div class="cg-management-grid">
            <div class="cg-prose" set:html={managementBlocks.slice(0, 2).join('')} />
            <div class="cg-management-actions" set:html={managementBlocks[2].replace('<ul>', '<ul role="list">')} />
          </div>
          <div class="cg-prose cg-management-notes" set:html={managementBlocks.slice(3).join('')} />
        </div>
      </section>
      <section id={landing.id} class="cg-section cg-landing">
        <div class="wrap">
          <h2 set:html={money(landing.title)} />
          <div class="cg-landing-grid">
            <div class="cg-prose" set:html={money(landing.html)} />
            <figure class="cg-landing-figure">
              <div class="cg-laptop" aria-hidden="true"><div class="cg-laptop-display"><div class="cg-demo-bar"><i></i><i></i><i></i></div><div class="cg-demo-software"><div class="cg-demo-sidebar"><b></b><span></span><span></span><span></span></div><div class="cg-demo-content"><b></b><div class="cg-demo-cards"><i></i><i></i><i></i></div><span></span><span></span><span></span><em></em></div></div></div><div class="cg-laptop-base"></div></div>
              <figcaption>Esempio illustrativo di landing</figcaption>
            </figure>
          </div>
        </div>
      </section>
      <section class="wrap cg-faq perizia-faq">
        <div><h2>{copy.faqTitle}</h2></div>
        <div>{copy.faqs.map(({question, html}) => <details><summary>{question}<span aria-hidden="true">+</span></summary><div class="cg-faq-answer" set:html={html} /></details>)}</div>
      </section>
      <section id={contactId} class="contact">
        <div class="wrap perizia-contact cg-contact">
          <div><h2>{copy.contactTitle}</h2><div class="cg-prose" set:html={copy.contactHtml} /><a class="plain lime" href="https://wa.me/393514656042">{copy.whatsapp}</a></div>
          <form id="pubblicita-su-chatgpt-form" method="post" action="https://api.web3forms.com/submit">
            <input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" />
            <input type="hidden" name="subject" value="Nuova richiesta ChatGPT Ads" />
            <input type="hidden" name="source_page" value="pubblicita-su-chatgpt" />
            <label>Nome e cognome *<input name="name" required autocomplete="name" /></label>
            <label>Email *<input name="email" type="email" required autocomplete="email" /></label>
            <label>Telefono — facoltativo<input name="phone" type="tel" autocomplete="tel" /></label>
            <label>Azienda o attività<input name="business" autocomplete="organization" /></label>
            <label class="cg-wide">Sito web — facoltativo<input name="site_url" type="url" placeholder="https://www.tuosito.it" autocomplete="url" /></label>
            <label class="cg-wide">Servizio da promuovere e obiettivo della campagna *<textarea name="message" required rows="4"></textarea></label>
            <label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
            <button class="button cg-wide" type="submit">{copy.submit}</button>
            <p class="privacy cg-wide" set:html={privacy} />
            <p id="pubblicita-su-chatgpt-status" class="form-status cg-wide" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>

