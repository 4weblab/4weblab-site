---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const whatsApp =
  "https://wa.me/393514656042?text=Ciao!%20Vorrei%20informazioni%20sui%20servizi%20di%204%20Web%20Lab.";
const checks = [
  "Struttura e prestazioni",
  "Google e indicizzazione",
  "Esperienza su mobile",
  "Conversione e messaggi",
  "Proprietà e accessi",
  "Priorità di intervento",
];
---

<!doctype html>
<html lang="it">
  <head>
    <SeoHead
      title="Perizia e creazione siti web a Padova | 4 Web Lab"
      description="Perizia e creazione siti web a Padova. Analizziamo ciò che blocca il tuo sito o progettiamo una presenza digitale che porta contatti."
      image="/images/og/home.webp"
    />
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <SiteHeader contactTarget="#contatti" showHome={false} />
    <main id="contenuto">
      <section class="hero">
        <div class="wrap hero-layout">
          <div class="hero-copy">
            <p class="hero-location">4 Web Lab · Padova / ovunque serva</p>
            <h1>Il tuo sito non<br /><em>lavora abbastanza.</em></h1>
            <p class="lead">Perizie tecniche e creazione siti web a Padova: prima di rifarlo, capiamo perché. Poi progettiamo una presenza digitale capace di trasformare attenzione in contatti.</p>
            <div class="actions"><a class="button" href="#perizia">Ho già un sito ↓</a><a class="plain light" href="#soluzioni">Devo crearne uno →</a></div>
          </div>
          <div class="hero-analysis" aria-label="Le aree considerate durante una perizia sito web">
            <div class="analysis-head"><span>Analisi iniziale</span><span class="analysis-status">In lettura</span></div>
            <div class="analysis-body">
              <p>Un sito non è una vetrina.<br /><strong>È una decisione di business.</strong></p>
              <dl>
                <div><dt>Struttura</dt><dd><i></i><i></i><i></i></dd></div>
                <div><dt>Visibilità</dt><dd><i></i><i></i><i></i></dd></div>
                <div><dt>Conversione</dt><dd><i></i><i></i><i></i></dd></div>
              </dl>
            </div>
            <div class="analysis-foot">Osserva prima di decidere</div>
          </div>
        </div>
      </section>
      <aside class="local-strip"><div class="wrap"><span>BASE A LEGNARO · PADOVA</span><p>Affianchiamo attività locali, professionisti e PMI in Veneto e in tutta Italia.</p><a href="/zone-servite">Scopri dove lavoriamo ↗</a></div></aside>
      <section id="perizia" class="section wrap perizia">
        <div><p class="eyebrow">Il punto di partenza</p><h2>Non sempre serve<br />un sito nuovo.</h2></div>
        <div><p class="statement">Se il sito non porta contatti, il problema può essere tecnico, strategico o semplicemente poco visibile. Una <strong>Perizia Sito Web</strong> separa i sintomi dalle cause.</p><a class="plain" href="/perizia-sito-web">Come funziona la perizia →</a></div>
        <div class="board">
          <div class="board-top">DIAGNOSI INDIPENDENTE <span><strong>ESSENTIAL</strong> / PREMIUM</span></div>
          <div class="board-main"><div><b>219€</b><p>Prezzo fisso.<br />Report scritto e priorità.</p></div><ul>{checks.map((check) => <li>✓ {check}</li>)}</ul></div>
          <div class="board-top muted"><span><strong>Essential · 219 € + IVA</strong> · consegna in 5-7 giorni lavorativi</span><span>Non è una perizia giurata o forense.</span></div>
        </div>
      </section>
      <section class="diagnostic-feature" aria-labelledby="diagnostic-feature-title">
        <div class="wrap diagnostic-feature-copy"><div><p class="eyebrow">Prima della soluzione</p><h2 id="diagnostic-feature-title">Leggere il sito<br />prima di <em>rifarlo.</em></h2></div><p>Ogni pagina, messaggio e scelta tecnica ha un peso. Li osserviamo insieme per capire dove intervenire e cosa lasciare stare.</p></div>
        <figure class="diagnostic-feature-visual"><img src="/images/website-diagnostic-editorial.webp" width="1672" height="941" loading="lazy" decoding="async" alt="Una pagina web scomposta in livelli, attraversata da una linea di analisi luminosa" /></figure>
      </section>
      <section id="soluzioni" class="section dark">
        <div class="wrap">
          <div class="services-title"><div><p class="eyebrow light">Soluzioni connesse</p><h2>Non attività<br /><em>scollegate.</em></h2></div><p>Ogni progetto nasce da un problema da risolvere, non da un pacchetto da vendere.</p></div>
          <div class="services">
            <a class="featured" href="/perizia-sito-web"><div class="service-copy"><small>Per chi ha già un sito</small><h3>Perizia sito web</h3><p>Hai già un sito, ma non sai cosa lo sta frenando? Lo analizziamo e ti consegniamo priorità chiare.</p></div><div class="service-art audit-art" aria-hidden="true"><span>Struttura</span><span>Visibilità</span><span>Conversione</span></div><span class="service-link">Scopri la perizia ↗</span></a>
            <a href="/sito-web-per-negozio"><div class="service-copy"><small>Presenza locale</small><h3>Siti per negozi e attività locali</h3><p>Una presenza locale che rende semplice trovarti, capire cosa fai e contattarti.</p></div><div class="service-art local-art" aria-hidden="true"><i></i><i></i><i></i></div><span class="service-link">Scopri la soluzione ↗</span></a>
            <a href="/sito-web-per-professionisti"><div class="service-copy"><small>Competenza chiara</small><h3>Siti per professionisti</h3><p>Un sito che rende chiara la tua competenza e trasforma ricerche in richieste qualificate.</p></div><img class="service-photo" src="/images/website-pages-editorial.webp" width="1254" height="1254" loading="lazy" decoding="async" alt="" /><span class="service-link">Scopri la soluzione ↗</span></a>
            <a href="/sito-web-aziendale"><div class="service-copy"><small>Offerta B2B</small><h3>Siti aziendali per PMI</h3><p>Una presenza digitale solida per raccontare offerta, metodo e valore a interlocutori B2B.</p></div><div class="service-art company-art" aria-hidden="true"><i></i><i></i><i></i><i></i></div><span class="service-link">Scopri la soluzione ↗</span></a>
            <a href="/pubblicita-su-google"><div class="service-copy"><small>Domanda attiva</small><h3>Pubblicità su Google (ADV)</h3><p>Campagne Google Ads progettate per intercettare una domanda già attiva e trasformarla in contatti misurabili.</p></div><div class="service-art search-art" aria-hidden="true"><span>cerca</span><i></i><i></i></div><span class="service-link">Scopri la soluzione ↗</span></a>
            <a href="/pubblicita-su-chatgpt"><div class="service-copy"><small>Nuovi contesti di scelta</small><h3>Pubblicità su ChatGPT (ADV)</h3><p>Campagne ChatGPT Ads pensate per rendere il tuo brand presente nei momenti in cui le persone stanno valutando una scelta.</p></div><div class="service-art conversation-art" aria-hidden="true"><i></i><i></i><i></i></div><span class="service-link">Scopri la soluzione ↗</span></a>
          </div>
        </div>
      </section>
      <section id="metodo" class="section wrap method">
        <div><p class="eyebrow">Il nostro metodo</p><h2>Meno promesse.<br /><em>Più chiarezza.</em></h2></div>
        <ol><li><small>01</small><div><h3>Guardiamo prima di proporre</h3><p>Contesto, obiettivi, ostacoli. Anche quando il problema non è il sito.</p></div></li><li><small>02</small><div><h3>Mettiamo in ordine le priorità</h3><p>Le azioni urgenti non sono sempre quelle più visibili. Le rendiamo leggibili.</p></div></li><li><small>03</small><div><h3>Costruiamo ciò che serve</h3><p>Design, contenuti e sviluppo lavorano insieme per portare alla prossima conversazione.</p></div></li></ol>
      </section>
      <section id="contatti" class="contact">
        <div class="wrap contact-grid">
          <div><p class="eyebrow light">Facciamo il primo passo</p><h2>Parti da una<br /><em>domanda vera.</em></h2><p>Hai un sito da verificare o un progetto da costruire? Raccontaci da dove parti.</p><a class="plain lime" href={whatsApp} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div>
          <form action="https://api.web3forms.com/submit" method="POST"><input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" /><input type="hidden" name="subject" value="Nuovo contatto dal sito 4 Web Lab" /><label class="honeypot" aria-hidden="true">Non compilare questo campo<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label><label>Nome<input name="name" required autocomplete="name" /></label><label>Email<input name="email" type="email" required autocomplete="email" /></label><label>Di cosa hai bisogno?<select name="esigenza"><option>Voglio una perizia</option><option>Devo creare un sito</option><option>Vorrei capire quale servizio mi serve</option></select></label><label>Raccontaci in due righe<textarea name="message" rows="3" required></textarea></label><button class="button" type="submit">Invia la richiesta ↗</button><p class="privacy">I dati sono usati solo per rispondere alla richiesta. <a href="/privacy">Privacy policy</a>.</p></form>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>


