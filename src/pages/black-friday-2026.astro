---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { SITE } from '../config/site';

const pageUrl = `${SITE.url}/black-friday-2026/`;
const description = 'Black Friday 2026 4 Web Lab: dal 2 al 27 novembre scopri l’offerta sulla realizzazione di siti web professionali e aziendali.';
const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  name: 'Black Friday 2026 4 Web Lab',
  description,
  url: pageUrl,
  inLanguage: 'it-IT',
  isPartOf: { '@id': `${SITE.url}/#website` },
}];
---

<!doctype html>
<html lang="it">
  <head>
    <SeoHead
      title="Black Friday 2026: 25% di sconto sui siti web | 4 Web Lab"
      description={description}
      image="/images/og/black-friday-2026.png"
      structuredData={structuredData}
    />
  </head>
  <body class="bf-prelanding">
    <main class="prelanding-shell">
      <section class="prelanding-card" aria-labelledby="prelanding-title">
        <a class="prelanding-brand" href="/" aria-label="4 Web Lab, home">4 <span>WEB<br />LAB</span></a>
        <p class="prelanding-eyebrow">Black Friday 2026</p>
        <h1 id="prelanding-title">25% di sconto<br /><em>sui siti web.</em></h1>
        <div class="prelanding-copy">
          <p>Grazie per il tuo interesse.</p>
          <p>L’offerta di 4 Web Lab sarà pubblicata e accessibile dal <strong>2 al 27 novembre 2026</strong>.</p>
          <p>Lascia il tuo indirizzo email e ti invieremo un promemoria quando l’offerta sarà disponibile.</p>
        </div>

        <form id="bf-prelanding-form" class="prelanding-form" method="post" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" />
          <input type="hidden" name="subject" value="Promemoria Black Friday 2026 - modulo pre-landing 4 Web Lab" />
          <input type="hidden" name="from_name" value="4 Web Lab - Pre-landing Black Friday 2026" />
          <input type="hidden" name="source_page" value="black-friday-2026-prelanding" />
          <input type="checkbox" name="botcheck" class="prelanding-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <label for="prelanding-email">Il tuo indirizzo email</label>
          <input id="prelanding-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="nome@esempio.it" required />
          <label class="prelanding-consent">
            <input name="privacy_consent" type="checkbox" value="accepted" required />
            <span>Acconsento all’uso del mio indirizzo email esclusivamente per ricevere un promemoria sull’inizio dell’offerta. <a href="/privacy/">Privacy Policy</a>.</span>
          </label>
          <button type="submit">Avvisami quando sarà disponibile</button>
          <p id="bf-prelanding-status" class="prelanding-status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <footer class="prelanding-footer"><a href="/privacy/">Privacy</a><span aria-hidden="true">·</span><a href="/cookie/">Cookie</a></footer>

    <script is:inline>
      const form = document.querySelector('#bf-prelanding-form');
      const status = document.querySelector('#bf-prelanding-status');
      const button = form?.querySelector('button[type="submit"]');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(button instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        button.disabled = true;
        button.textContent = 'Invio…';
        status.textContent = '';
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
          const data = await response.json();
          if (!response.ok || !data.success) throw new Error('send');
          form.reset();
          status.textContent = 'Grazie. Ti invieremo un promemoria quando l’offerta sarà disponibile.';
        } catch {
          status.textContent = 'Non è stato possibile inviare la richiesta. Riprova tra poco.';
        } finally {
          button.disabled = false;
          button.textContent = 'Avvisami quando sarà disponibile';
        }
      });
    </script>

    <style>
      .bf-prelanding { min-height: 100svh; margin: 0; background: #101c31; color: #f7f4ec; font-family: var(--sans, Arial, sans-serif); }
      .prelanding-shell { display: grid; min-height: calc(100svh - 55px); place-items: center; padding: 48px 24px 72px; }
      .prelanding-card { position: relative; width: min(100%, 720px); padding: clamp(42px, 8vw, 84px); border: 1px solid rgb(215 255 47 / .6); background: linear-gradient(135deg, #16243d, #0b1425); box-shadow: 18px 18px 0 #d7ff2f; }
      .prelanding-card::after { position: absolute; top: 0; right: 0; width: 28%; height: 100%; background: rgb(215 255 47 / .08); clip-path: polygon(52% 0, 100% 0, 100% 100%, 0 100%); content: ''; pointer-events: none; }
      .prelanding-brand, .prelanding-eyebrow, .prelanding-copy, .prelanding-form { position: relative; z-index: 1; }
      .prelanding-brand { display: inline-flex; align-items: center; gap: 9px; color: #d7ff2f; font: 700 16px/1 var(--sans, Arial, sans-serif); letter-spacing: .08em; text-decoration: none; }
      .prelanding-brand::first-letter { font-size: 31px; }
      .prelanding-brand span { color: #f7f4ec; font-size: 10px; line-height: .88; letter-spacing: .16em; }
      .prelanding-eyebrow { margin: clamp(70px, 10vw, 110px) 0 22px; color: #ff665c; font: 11px/1.4 var(--mono, monospace); letter-spacing: .14em; text-transform: uppercase; }
      .prelanding-card h1 { max-width: 620px; margin: 0; color: #f7f4ec; font: 600 clamp(58px, 10vw, 112px)/.9 var(--serif, Georgia, serif); letter-spacing: -.05em; }
      .prelanding-card h1 em { display: inline-block; margin-top: .08em; padding: .04em .1em .14em; color: #101c31; background: #d7ff2f; font-style: italic; line-height: 1.1; }
      .prelanding-copy { max-width: 500px; margin: 38px 0 0; color: #d8e2ef; font-size: 18px; line-height: 1.55; }
      .prelanding-copy p { margin: 0 0 16px; }
      .prelanding-copy strong { color: #fff; }
      .prelanding-form { display: grid; gap: 12px; max-width: 500px; margin-top: 38px; }
      .prelanding-form > label:first-of-type { color: #f7f4ec; font-size: 14px; font-weight: 700; }
      .prelanding-form > input[type='email'] { width: 100%; min-height: 52px; box-sizing: border-box; border: 1px solid rgb(255 255 255 / .45); border-radius: 0; background: rgb(255 255 255 / .05); color: #fff; padding: 13px 15px; font: inherit; }
      .prelanding-form > input[type='email']::placeholder { color: #aebdce; }
      .prelanding-form > input[type='email']:focus { outline: 3px solid #d7ff2f; outline-offset: 2px; }
      .prelanding-consent { display: flex; align-items: flex-start; gap: 10px; color: #b9c8d8; font-size: 12px; line-height: 1.45; }
      .prelanding-consent input { flex: 0 0 auto; width: 16px; height: 16px; margin-top: 1px; accent-color: #d7ff2f; }
      .prelanding-consent a { color: #d7ff2f; }
      .prelanding-form button { min-height: 52px; border: 0; border-radius: 0; background: #d7ff2f; color: #101c31; padding: 14px 18px; font: 700 14px/1 var(--sans, Arial, sans-serif); cursor: pointer; }
      .prelanding-form button:hover { background: #ecff87; }
      .prelanding-form button:disabled { cursor: wait; opacity: .7; }
      .prelanding-status { min-height: 1.5em; margin: 2px 0 0; color: #d7ff2f; font-size: 14px; line-height: 1.4; }
      .prelanding-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
      .prelanding-footer { display: flex; justify-content: center; gap: 10px; min-height: 55px; color: #aebdce; font-size: 12px; }
      .prelanding-footer a { color: inherit; }
      @media (max-width: 680px) { .prelanding-shell { padding: 24px 20px 60px; }.prelanding-card { padding: 32px 25px 38px; box-shadow: 10px 10px 0 #d7ff2f; }.prelanding-eyebrow { margin-top: 68px; }.prelanding-card h1 { font-size: clamp(52px, 15vw, 76px); }.prelanding-copy { font-size: 17px; } }
      @media (prefers-reduced-motion: reduce) { .bf-prelanding * { scroll-behavior: auto !important; } }
    </style>
  </body>
</html>
