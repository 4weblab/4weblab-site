---
import '../../styles/global.css';
import SeoHead from '../../components/SeoHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';

const pageUrl = `${SITE.url}/realizzazioni/realizzazione-sito-web-edilizia-rb-snc-veneto`;
const liveUrl = 'https://rb-snc.it';
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: `${SITE.url}/realizzazioni` },
    { '@type': 'ListItem', position: 3, name: 'R.B. s.n.c.', item: pageUrl },
  ] },
  { '@type': 'CreativeWork', '@id': `${pageUrl}#case-study`, name: 'R.B. s.n.c. — sito web, SEO e Google Ads', url: pageUrl, inLanguage: 'it-IT', author: { '@id': `${SITE.url}/#business` }, creator: { '@id': `${SITE.url}/#business` }, about: { '@type': 'Organization', name: 'R.B. s.n.c. di Bertoluzzo e Ragazzo', url: liveUrl, description: 'Impresa edile specializzata in rimozione eternit e rifacimento tetti, con sede a Cittadella (Padova).' }, workExample: { '@type': 'WebSite', name: 'rb-snc.it', url: liveUrl } },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title="Caso studio R.B. s.n.c.: sito web, SEO e Google Ads | 4 Web Lab" description="Caso studio R.B. s.n.c. di Cittadella: restyling del sito, SEO on-page e supporto Google Ads per un'impresa edile specializzata in rimozione eternit e rifacimento tetti." image="/images/og/rb-snc-edilizia.webp" structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="/contatti" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Portfolio', href: '/realizzazioni' }, { label: 'R.B. s.n.c.' }]} /></div></div>
  <section class="rb-hero"><div class="wrap rb-hero-grid"><div><p class="hero-location">Caso studio reale · Cittadella / Veneto</p><h1>Un sito che rende<br />l’impresa <em>più trovabile.</em></h1><p class="lead">Per R.B. s.n.c. abbiamo ricostruito il sito, organizzato le informazioni di servizio e creato una base tecnica utile alla ricerca organica e alle campagne Google Ads.</p><div class="actions"><a class="button" href={liveUrl} target="_blank" rel="noopener external">Visita rb-snc.it ↗</a><a class="plain light" href="#intervento">Vedi l’intervento ↓</a></div></div><div class="rb-hero-media"><img src="/images/portfolio/rb-snc-edilizia.webp" width="1600" height="1000" alt="Operaio con dispositivi di protezione durante un intervento su una copertura, progetto R.B. s.n.c." fetchpriority="high" /></div></div></section>

  <section class="section wrap rb-context"><div><p class="eyebrow">Il punto di partenza</p><h2>Un sito fermo<br />nel tempo.<br /><em>Un servizio no.</em></h2></div><div><p class="statement">R.B. s.n.c. opera in un settore tecnico, locale e competitivo: chi cerca bonifica amianto, rimozione eternit o rifacimento tetti deve capire subito competenze, servizi e area operativa.</p><p>Il sito precedente risaliva al 2010, con struttura e visual non più adatti alla consultazione da mobile né alla presenza sui motori di ricerca. Il progetto non chiedeva un semplice restyling: serviva una nuova base per comunicare e farsi trovare.</p></div></section>

  <section class="rb-before"><div class="wrap rb-before-grid"><div class="rb-before-copy"><p class="eyebrow">Prima</p><h2>Una presenza<br /><em>da ripensare.</em></h2><ul><li><small>01</small><span>Esperienza pensata solo per desktop</span></li><li><small>02</small><span>Servizi e contatti poco ordinati</span></li><li><small>03</small><span>Base SEO e dati strutturati assenti</span></li></ul></div><figure><img src="/images/case-rb-snc/before-2010.webp" width="1600" height="721" alt="Schermata del sito precedente di R.B. s.n.c., con layout datato non ottimizzato per mobile" loading="lazy" /><figcaption>Il sito precedente · 2010</figcaption></figure></div></section>

  <section id="intervento" class="rb-solution section wrap"><div class="rb-solution-heading"><p class="eyebrow">L’intervento</p><h2>Dal sito al<br /><em>percorso di ricerca.</em></h2><p>Design, contenuti e visibilità non sono stati affrontati come attività separate: ogni parte è stata costruita per rendere più chiara la scelta dell’utente e la richiesta di preventivo.</p></div><div class="rb-solution-grid"><article><span>01</span><h3>Nuova struttura</h3><p>Architettura dei contenuti, pagine di servizio e contatti pensati per spiegare bonifica, rimozione eternit e rifacimento coperture.</p></article><article><span>02</span><h3>Design e mobile</h3><p>Un’interfaccia più leggibile, con gerarchie visive e call to action utilizzabili anche da smartphone.</p></article><article><span>03</span><h3>SEO on-page e locale</h3><p>Title, struttura dei contenuti, informazioni territoriali e fondazioni tecniche utili per l’indicizzazione.</p></article><article><span>04</span><h3>Supporto Google Ads</h3><p>Un sito pronto a diventare destinazione della campagna: messaggi, pagine e contatti coerenti con le ricerche di servizio.</p></article></div></section>

  <section class="rb-after"><div class="wrap"><div class="rb-after-heading"><p class="eyebrow light">Dopo</p><h2>Più chiaro<br />da vedere.<br /><em>Più facile da usare.</em></h2><p>Il nuovo sito unisce presentazione dell’impresa, pagine di servizio e punti di contatto in un percorso più ordinato.</p></div><div class="rb-showcase"><figure class="rb-desktop"><img src="/images/case-rb-snc/after-desktop.webp" width="1600" height="711" alt="Homepage del nuovo sito R.B. s.n.c. con servizi e call to action" loading="lazy" /><figcaption>Homepage · desktop</figcaption></figure><figure class="rb-mobile"><img src="/images/case-rb-snc/after-mobile.webp" width="900" height="780" alt="Pagina del nuovo sito R.B. s.n.c. visualizzata su mobile" loading="lazy" /><figcaption>Esperienza mobile</figcaption></figure><figure class="rb-detail"><img src="/images/case-rb-snc/after-detail.webp" width="1600" height="727" alt="Pagina di dettaglio del nuovo sito R.B. s.n.c. dedicata a un intervento su copertura" loading="lazy" /><figcaption>Pagina di servizio · desktop</figcaption></figure></div></div></section>

  <section class="section wrap rb-technical"><div><p class="eyebrow">La base tecnica</p><h2>Non solo una<br />nuova <em>facciata.</em></h2></div><div><p class="statement">La qualità del progetto non si esaurisce nel design. Il sito è stato ricostruito per essere più leggero, consultabile e leggibile anche dai sistemi che devono interpretarlo.</p><div class="rb-technical-list"><article><h3>Performance</h3><p>Asset ottimizzati, immagini WebP e layout progettato per ridurre attriti di caricamento e consultazione.</p></article><article><h3>SEO tecnico</h3><p>Gerarchia dei titoli, metadati, sitemap, canonical e struttura delle pagine di servizio.</p></article><article><h3>Dati strutturati</h3><p>Informazioni organizzate per aiutare i motori di ricerca a comprendere attività, servizi e territorio.</p></article></div><p class="rb-note"><strong>Nota:</strong> non pubblichiamo dati commerciali o di campagna del cliente. Il caso studio racconta le attività svolte e le scelte progettuali, non promesse di risultato.</p></div></section>

  <section class="rb-next"><div class="wrap rb-next-grid"><div><p class="eyebrow light">Un progetto reale</p><h2>Hai un sito<br />che non sostiene<br /><em>più il lavoro?</em></h2></div><div><p>Prima di investire in un nuovo sito o in pubblicità, conviene capire se la presenza attuale è una base su cui costruire oppure un limite da risolvere.</p><div class="actions"><a class="button" href="/perizia-sito-web">Scopri la perizia →</a><a class="plain lime" href="/contatti">Parliamone →</a></div></div></div></section>
</main><SiteFooter />
</body></html>
