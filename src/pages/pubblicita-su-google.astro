---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';

const pageUrl = `${SITE.url}/pubblicita-su-google`;
const faqs = [
  ['Quanto costa gestire una campagna Google Ads?', 'La gestione professionale parte da 299 € + IVA al mese. Il budget media è separato e viene definito in base a mercato, area e obiettivi.'],
  ['In quanto tempo arrivano i primi risultati?', 'Una campagna può generare click e richieste fin dalla pubblicazione. Per valutare dati e ottimizzazioni servono normalmente alcune settimane di attività.'],
  ['Google Ads è utile anche per attività locali?', 'Sì, quando esiste una domanda di ricerca e l’offerta può essere spiegata da una pagina pertinente. Geo-targeting e parole chiave evitano di pagare visite fuori contesto.'],
  ['Che differenza c’è tra SEO e Google Ads?', 'Google Ads acquista visibilità per ricerche specifiche; la SEO costruisce visibilità organica nel tempo. Possono lavorare insieme, ma hanno tempi e logiche diverse.'],
];
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Pubblicità Google Ads', item: pageUrl }] },
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: 'Gestione campagne Google Ads', description: 'Progettazione, gestione e ottimizzazione di campagne Google Ads per attività, professionisti e aziende.', serviceType: 'Google Ads management', provider: { '@id': `${SITE.url}/#business` }, areaServed: [{ '@type': 'AdministrativeArea', name: 'Veneto' }, { '@type': 'Country', name: 'Italia' }], url: pageUrl, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, offers: { '@type': 'Offer', priceCurrency: 'EUR', price: '299', priceSpecification: { '@type': 'UnitPriceSpecification', price: '299', priceCurrency: 'EUR', valueAddedTaxIncluded: false, unitText: 'MONTH' } } },
  { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title="Gestione campagne Google Ads a Padova | 4 Web Lab" description="Gestione Google Ads per attività, professionisti e aziende: campagne orientate a richieste concrete, tracciamenti chiari e budget senza sprechi." image="/images/og/pubblicita-su-google.webp" structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="#contatti-google-ads" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Pubblicità Google Ads' }]} /></div></div>
  <section class="ads-hero"><div class="wrap ads-hero-grid"><div><p class="hero-location">Gestione Google Ads · Padova / tutta Italia</p><h1>Fatti trovare<br /><em>quando serve.</em></h1><p class="lead">Le campagne Google Ads hanno senso quando intercettano una domanda già attiva e la portano su una pagina capace di trasformarla in contatto.</p><div class="actions"><a class="button" href="#contatti-google-ads">Parliamo della campagna ↓</a><a class="plain light" href="#metodo-google-ads">Come lavoriamo →</a></div></div><img src="/images/google-ads-hero.webp" width="1280" height="960" alt="Analisi di una campagna Google Ads" fetchpriority="high" /></div></section>
  <section class="section wrap ads-intro"><div><p class="eyebrow">Non acquistiamo solo click</p><h2>Partiamo dalla<br />domanda.<br /><em>Non dal budget.</em></h2></div><div><p class="statement">Prima di attivare una campagna, capiamo cosa cerca una persona, quali parole usa e quale azione può compiere sul vostro sito.</p><p>Così il budget non finisce in traffico generico: viene assegnato a ricerche, aree e messaggi collegati a un obiettivo misurabile.</p><p class="context-link">Se il sito ha molti anni, è lento o non porta richieste, forse non serve aumentare la pubblicità: una <a href="/perizia-sito-web">Perizia Sito Web</a> aiuta prima a capire cosa sta bloccando il percorso.</p></div></section>
  <section class="ads-intent"><div class="ads-intent-grid"><div class="ads-intent-heading"><p class="eyebrow">Dall’intento alla richiesta</p><h2>Ogni click deve<br />avere un<br /><em>perché.</em></h2></div><div class="ads-intent-intro"><p class="statement">La pubblicità non sostituisce un’offerta poco chiara. La rende visibile a chi sta già valutando una soluzione.</p></div><div class="ads-intent-points"><article><span>01</span><h3>Selezioniamo le ricerche</h3><p>Parole chiave, esclusioni e località aiutano a filtrare la domanda non pertinente.</p></article><article><span>02</span><h3>Costruiamo il messaggio</h3><p>Annunci e landing page dichiarano beneficio, contesto e prossimo passo in modo coerente.</p></article><article><span>03</span><h3>Misuriamo le azioni</h3><p>Chiamate, form e richieste diventano dati per decidere dove migliorare la campagna.</p></article></div></div></section>
  <section id="metodo-google-ads" class="section wrap ads-method"><div><img src="/images/google-ads-method.webp" width="1280" height="960" loading="lazy" alt="Pianificazione di una campagna pubblicitaria" /></div><div><p class="eyebrow">Un metodo leggibile</p><h2>Campagne<br />che <em>imparano.</em></h2><ol><li><small>01</small><div><h3>Analisi e obiettivi</h3><p>Definiamo la richiesta utile: preventivo, chiamata, prenotazione o vendita.</p></div></li><li><small>02</small><div><h3>Setup e controllo</h3><p>Impostiamo annunci, conversioni e pagine di atterraggio coerenti.</p></div></li><li><small>03</small><div><h3>Ottimizzazione</h3><p>Leggiamo costi e qualità delle richieste per correggere budget, parole e messaggi.</p></div></li></ol></div></section>
  <section class="ads-price"><div class="wrap"><div class="price-card"><p class="plan-label">GESTIONE GOOGLE ADS</p><ul><li>✓ Analisi di domanda e concorrenza</li><li>✓ Setup campagne e conversioni</li><li>✓ Copy degli annunci</li><li>✓ Ottimizzazione continuativa</li><li>✓ Report con risultati e prossimi passi</li></ul><a class="button" href="#contatti-google-ads">Richiedi una consulenza →</a><small>Il budget pubblicitario è sempre separato dal compenso di gestione.</small></div><div><p class="eyebrow light">Gestione</p><h2>Da <em>299 €</em><br />al mese + IVA.</h2><p>Prima consulenza senza impegno: valutiamo insieme domanda, concorrenza e sostenibilità di una campagna per il tuo settore.</p></div></div></section>
  <section class="section wrap perizia-faq"><div><p class="eyebrow">Domande frequenti</p><h2>Prima di<br />investire.</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
  <section id="contatti-google-ads" class="contact"><div class="wrap perizia-contact"><div><p class="eyebrow light">Parliamo della tua campagna</p><h2>Parti da ciò<br />che vuoi <em>ottenere.</em></h2><p>Raccontaci attività, area e obiettivo. Ti restituiamo una prima lettura onesta della fattibilità.</p><a class="plain lime" href="https://wa.me/393514656042">WhatsApp ↗</a></div><form id="google-ads-form" method="post" action="https://api.web3forms.com/submit"><input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" /><input type="hidden" name="subject" value="Nuova richiesta Google Ads" /><input type="hidden" name="source_page" value="pubblicita-su-google" /><label>Nome e cognome *<input name="name" required autocomplete="name" /></label><label>Email *<input name="email" type="email" required autocomplete="email" /></label><label>Telefono<input name="phone" type="tel" autocomplete="tel" /></label><label>Azienda o attività<input name="business" autocomplete="organization" /></label><label>Obiettivo della campagna *<textarea name="message" required rows="3"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><button class="button" type="submit">Invia la richiesta ↗</button><p class="privacy">I dati sono usati solo per rispondere alla richiesta. <a href="/privacy">Privacy policy</a>.</p><p id="google-ads-status" class="form-status" aria-live="polite"></p></form></div></section>
</main><SiteFooter />
<script is:inline>const form=document.querySelector('#google-ads-form'),status=document.querySelector('#google-ads-status');form?.addEventListener('submit',async event=>{event.preventDefault();if(form.website.value)return;const button=form.querySelector('button[type="submit"]');button.disabled=true;button.textContent='Invio in corso…';status.textContent='';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok||!data.success)throw new Error('send');form.reset();status.textContent='Richiesta inviata. Ti rispondiamo entro 24 ore lavorative.'}catch{status.textContent='Invio non riuscito. Riprova tra poco o contattaci su WhatsApp.'}finally{button.disabled=false;button.textContent='Invia la richiesta ↗'}});</script>
</body></html>


