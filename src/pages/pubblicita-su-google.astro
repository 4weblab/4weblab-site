---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { SITE } from '../config/site';

const pageUrl = `${SITE.url}/pubblicita-su-google/`;
const faqs = [
  ['Quanto costa gestire una campagna Google Ads?', 'La gestione professionale parte da 299 € + IVA al mese. Il budget media è separato e viene definito in base a mercato, area e obiettivi.'],
  ['In quanto tempo arrivano i primi risultati?', 'Una campagna può generare click e richieste fin dalla pubblicazione. Per valutare dati e ottimizzazioni servono normalmente alcune settimane di attività.'],
  ['Google Ads è utile anche per attività locali?', 'Sì, quando esiste una domanda di ricerca e l’offerta può essere spiegata da una pagina pertinente. Geo-targeting e parole chiave evitano di pagare visite fuori contesto.'],
  ['Che differenza c’è tra SEO e Google Ads?', 'Google Ads acquista visibilità per ricerche specifiche; la SEO costruisce visibilità organica nel tempo. Possono lavorare insieme, ma hanno tempi e logiche diverse.'],
];
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Pubblicità Google Ads', item: pageUrl }] },
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: 'Gestione campagne Google Ads', description: 'Progettazione, gestione e ottimizzazione di campagne Google Ads per attività, professionisti e aziende.', serviceType: 'Google Ads management', provider: { '@id': `${SITE.url}/#business` }, areaServed: [{ '@type': 'AdministrativeArea', name: 'Veneto' }, { '@type': 'Country', name: 'Italia' }], url: pageUrl, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, offers: { '@type': 'Offer', priceCurrency: 'EUR', price: '299', priceSpecification: { '@type': 'UnitPriceSpecification', price: '299', priceCurrency: 'EUR', valueAddedTaxIncluded: false, unitText: 'MONTH' } } },
  { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title="Gestione campagne Google Ads a Padova | 4 Web Lab" description="Gestione Google Ads per attività, professionisti e aziende: campagne orientate a richieste concrete, tracciamenti chiari e budget senza sprechi." image="/images/og/pubblicita-su-google.webp" structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="#contatti-google-ads" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Pubblicità Google Ads' }]} /></div></div>
  <section class="ads-hero"><div class="wrap ads-hero-grid"><div><p class="hero-location">GOOGLE ADS · PADOVA E ITALIA</p><h1>Gestione campagne<br /><em>Google Ads a Padova.</em></h1><p class="lead">Portiamo il tuo budget davanti a persone che stanno già cercando un servizio come il tuo. Prima controlliamo domanda, pagina e tracciamenti: poi decidiamo se la campagna ha senso.</p><div class="actions"><a class="button" href="#contatti-google-ads">Parliamo della campagna →</a><a class="plain light" href="#metodo-google-ads">Come lavoriamo →</a></div></div></div></section>
  <section class="section wrap ads-intro"><div><p class="eyebrow">NON COMPRIAMO SOLO CLICK</p><h2>Partiamo dalla<br />domanda.<br /><em>Non dal budget.</em></h2></div><div><p class="statement">Una campagna Google Ads funziona solo se intercetta una ricerca pertinente e porta a una pagina capace di rispondere bene.</p><p>Prima di investire analizziamo cosa cercano le persone, quali parole usano, in quale area si trovano e quale azione vuoi ottenere.</p><p class="context-link">Se il sito è lento, confuso o non porta richieste, aumentare la pubblicità può solo rendere più costoso il problema. Una <a href="/perizia-sito-web/">perizia tecnica indipendente</a> aiuta a capire da dove partire.</p></div></section>
  <section class="ads-intent"><div class="ads-intent-grid"><div class="ads-intent-heading"><p class="eyebrow">DALLA RICERCA ALLA RICHIESTA</p><h2>Ogni click<br />deve avere<br />un <em>perché.</em></h2></div><div class="ads-intent-intro"><p class="statement">Google Ads non serve a portare più persone a caso. Serve a intercettare ricerche compatibili con la tua offerta e accompagnarle verso un’azione misurabile.</p></div><div class="ads-intent-points"><article><span>01</span><h3>Selezioniamo le ricerche</h3><p>Scegliamo parole chiave, aree e intenzioni coerenti con ciò che vendi. Escludiamo le ricerche che consumano budget senza possibilità concreta di diventare contatti.</p></article><article><span>02</span><h3>Costruiamo il messaggio</h3><p>Annunci e pagina di destinazione devono parlare della stessa cosa: problema, soluzione, vantaggio e prossimo passo.</p></article><article><span>03</span><h3>Misuriamo le azioni</h3><p>Form, chiamate, richieste e vendite diventano dati utili per capire cosa mantenere, cosa correggere e dove spostare il budget.</p></article></div></div></section>
  <section id="metodo-google-ads" class="section wrap ads-method"><div><ResponsiveImage src="/images/google-ads-method.webp" width={1024} height={1024} sizes="(max-width: 900px) calc(100vw - 40px), 40vw" alt="Pianificazione di una campagna pubblicitaria" /></div><div><p class="eyebrow">UN METODO LEGGIBILE</p><h2>Campagne<br />che <em>imparano.</em></h2><ol><li><small>01</small><div><h3>Analisi e obiettivi</h3><p>Definiamo cosa deve produrre la campagna: una richiesta di preventivo, una chiamata, una prenotazione o una vendita.</p></div></li><li><small>02</small><div><h3>Setup e controllo</h3><p>Configuriamo campagne, annunci, conversioni e pagine di atterraggio coerenti con l’obiettivo.</p></div></li><li><small>03</small><div><h3>Ottimizzazione</h3><p>Analizziamo costi e qualità delle richieste per correggere parole chiave, messaggi, aree e distribuzione del budget.</p></div></li></ol></div></section>
  <section class="ads-price"><div class="wrap"><div class="price-card"><p class="plan-label">GESTIONE GOOGLE ADS</p><ul><li>✓ Analisi della domanda e della concorrenza</li><li>✓ Setup delle campagne</li><li>✓ Configurazione delle conversioni</li><li>✓ Copy degli annunci</li><li>✓ Ottimizzazione continuativa</li><li>✓ Report con risultati e prossimi passi</li></ul><a class="button" href="#contatti-google-ads">Richiedi una consulenza →</a><small>Il budget pubblicitario è sempre separato dal compenso di gestione.</small></div><div><p class="eyebrow light">Gestione</p><h2>Da <em>299 €</em><br />al mese + IVA.</h2><p>Prima di iniziare valutiamo domanda, concorrenza, area geografica e sostenibilità della campagna per il tuo settore.</p></div></div></section>
  <section class="section wrap perizia-faq"><div><p class="eyebrow">DOMANDE FREQUENTI</p><h2>Prima di<br />investire.</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
  <section id="contatti-google-ads" class="contact"><div class="wrap perizia-contact"><div><p class="eyebrow light">PARLIAMO DELLA TUA CAMPAGNA</p><h2>Parti da ciò<br />che vuoi <em>ottenere.</em></h2><p>Raccontaci attività, area e obiettivo. Ti restituiamo una prima valutazione della domanda, della pagina e della sostenibilità della campagna.</p><a class="plain lime" href="https://wa.me/393514656042">WhatsApp ↗</a></div><form id="google-ads-form" method="post" action="https://api.web3forms.com/submit"><input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" /><input type="hidden" name="subject" value="Nuova richiesta Google Ads" /><input type="hidden" name="source_page" value="pubblicita-su-google" /><label>Nome e cognome *<input name="name" required autocomplete="name" /></label><label>Email *<input name="email" type="email" required autocomplete="email" /></label><label>Telefono<input name="phone" type="tel" autocomplete="tel" /></label><label>Azienda o attività<input name="business" autocomplete="organization" /></label><label>Obiettivo della campagna *<textarea name="message" required rows="3"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><button class="button" type="submit">Invia la richiesta →</button><p class="privacy">I dati sono usati solo per rispondere alla richiesta. <a href="/privacy/">Privacy policy</a>.</p><p id="google-ads-status" class="form-status" aria-live="polite"></p></form></div></section>
</main><SiteFooter />
<script is:inline>const form=document.querySelector('#google-ads-form'),status=document.querySelector('#google-ads-status');form?.addEventListener('submit',async event=>{event.preventDefault();if(form.website.value)return;const button=form.querySelector('button[type="submit"]');button.disabled=true;button.textContent='Invio in corso…';status.textContent='';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok||!data.success)throw new Error('send');form.reset();status.textContent='Richiesta inviata. Ti rispondiamo entro 24 ore lavorative.'}catch{status.textContent='Invio non riuscito. Riprova tra poco o contattaci su WhatsApp.'}finally{button.disabled=false;button.textContent='Invia la richiesta ↗'}});</script>
</body></html>


