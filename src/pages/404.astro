---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
---

<!doctype html>
<html lang="it">
  <head>
    <SeoHead title="Pagina non trovata | 4 Web Lab" description="La pagina che stai cercando non è disponibile." noindex />
  </head>
  <body class="not-found-page">
    <main class="not-found wrap">
      <p class="eyebrow">Errore 404</p>
      <h1>Questa pagina<br />non c’è.</h1>
      <p>Potrebbe essere stata spostata oppure l’indirizzo non è corretto.</p>
      <a class="button" href="/">Torna alla home</a>
    </main>
  </body>
</html>


