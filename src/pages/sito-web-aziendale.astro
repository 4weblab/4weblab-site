---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { SITE } from '../config/site';

const pageUrl = `${SITE.url}/sito-web-aziendale`;
const faqs = [
  ['Quanto costa un sito web aziendale?', 'Un sito web aziendale parte da 1.890 € + IVA. Il preventivo dipende da struttura, pagine, contenuti, lingue e integrazioni realmente necessarie.'],
  ['Quanto tempo serve?', 'Un progetto aziendale richiede in media da 2 a 6 settimane, in base alla disponibilità dei contenuti e alla complessità del percorso.'],
  ['Il sito è adatto anche al B2B?', 'Sì. Per il B2B il sito deve rendere verificabili competenze, servizi, casi e canali di contatto prima della richiesta commerciale.'],
  ['Il sito include la SEO?', 'Ogni progetto include una base SEO tecnica e on-page. Visibilità e risultati dipendono poi da concorrenza, contenuti e attività continuative.'],
  ['Cosa succede dopo la pubblicazione?', 'Il sito può evolvere con nuovi servizi, mercati, casi e materiali commerciali. Quando l’obiettivo è generare domanda, valutiamo anche campagne Google Ads o ChatGPT Ads in base a fattibilità e pubblico. Con hosting gestito integralmente da 4 Web Lab, la manutenzione tecnica ordinaria e straordinaria è inclusa.'],
];
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Siti web aziendali', item: pageUrl }] },
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: 'Siti web aziendali', description: 'Progettazione e realizzazione di siti web aziendali per PMI, imprese e attività B2B.', serviceType: 'Web design aziendale', provider: { '@id': `${SITE.url}/#business` }, areaServed: [{ '@type': 'AdministrativeArea', name: 'Veneto' }, { '@type': 'Country', name: 'Italia' }], url: pageUrl, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, offers: { '@type': 'Offer', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', minPrice: '1890', priceCurrency: 'EUR', valueAddedTaxIncluded: false } } },
  { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title="Siti web aziendali per PMI e imprese | 4 Web Lab" description="Siti web aziendali per PMI e imprese: struttura, contenuti e SEO tecnica per rendere chiari servizi, competenze e contatti. Da 1.890 € + IVA." image="/images/og/sito-web-aziendale.webp" structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="#contatti-aziendali" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Siti web aziendali' }]} /></div></div>
  <section class="aziendali-hero"><div class="wrap aziendali-hero-grid"><div><p class="hero-location">SITI WEB AZIENDALI · PADOVA E ITALIA</p><h1>Siti web aziendali<br /><em>per PMI e imprese.</em></h1><p class="lead">Un sito aziendale deve spiegare cosa fate, dimostrare perché siete credibili e aiutare clienti, partner e candidati a capire quale sia il prossimo passo.</p><div class="actions"><a class="button" href="#contatti-aziendali">Parliamo del progetto →</a><a class="plain light" href="#struttura-aziendale">Cosa comprende →</a></div></div></div></section>
  <section class="section wrap aziendali-intro"><div><p class="section-context">PRIMA DEL CONTATTO</p><h2>Prima di contattarvi<br />devono capire<br /><em>chi siete.</em></h2></div><div><p class="statement">Un potenziale cliente non visita il sito aziendale per ammirare una brochure. Lo usa per capire se avete l’esperienza, i servizi e il metodo adatti al suo problema.</p><p>Per questo organizziamo pagine, contenuti e navigazione intorno alle domande reali di chi deve scegliere: cosa fate, per chi lavorate, come operate e perché dovrebbe fidarsi.</p><p class="context-link">Se il sito attuale non chiarisce questi punti, una <a href="/perizia-sito-web">perizia tecnica indipendente</a> aiuta a stabilire cosa correggere prima di rifarlo.</p></div></section>
  <section id="struttura-aziendale" class="aziendali-structure"><div class="aziendali-structure-grid"><div class="structure-heading"><p class="section-context">LA STRUTTURA DEL SITO</p><h2>Ogni pagina<br />deve aiutare<br /><em>a decidere.</em></h2></div><div class="structure-intro"><p class="statement">La realizzazione di un sito aziendale parte dal percorso che una persona deve compiere prima di inviare una richiesta o aprire una trattativa.</p></div><div class="structure-points"><article><span class="service-signal">Offerta</span><h3>Presentare cosa fate</h3><p>Servizi e soluzioni sono organizzati in modo chiaro, con contenuti specifici e collegamenti ai problemi che aiutano a risolvere.</p></article><article><span class="service-signal">Prove</span><h3>Dimostrare come lavorate</h3><p>Settori, metodo, competenze, team e casi reali rendono verificabile ciò che l’azienda promette.</p></article><article><span class="service-signal">Contatto</span><h3>Rendere semplice il prossimo passo</h3><p>Call to action, form e canali diretti aiutano il visitatore a chiedere informazioni senza dover cercare da solo cosa fare.</p><p class="context-link">Quando esiste una domanda già attiva, il sito può diventare la destinazione di campagne <a href="/pubblicita-su-google">Google Ads</a>. Prima verifichiamo che la pagina sia pronta a ricevere traffico.</p></article></div></div></section>
  <section class="section wrap aziendali-proof"><div><ResponsiveImage src="/images/aziendali-team.webp" width={1280} height={960} sizes="(max-width: 900px) calc(100vw - 40px), 40vw" alt="Team aziendale al lavoro" /></div><div><p class="section-context">PER CHI DEVE SCEGLIERVI</p><h2>Un’azienda non cerca<br />solo un fornitore.<br /><em>Cerca elementi concreti.</em></h2><p class="statement">Nel B2B la scelta raramente dipende da una sola pagina. Il sito deve accompagnare una valutazione e rendere comprensibili competenze, servizi, differenze e modalità di contatto.</p><ul><li><small>Servizi</small><span>Pagine chiare per spiegare cosa offrite e a chi è utile.</span></li><li><small>Ricerca</small><span>Una base SEO tecnica e contenuti organizzati intorno alle domande rilevanti.</span></li><li><small>Affidabilità</small><span>Una struttura veloce, accessibile e aggiornata, senza informazioni difficili da verificare.</span></li></ul></div></section>
  <section class="continuity-service aziendali-continuity"><div class="wrap continuity-grid"><div><p class="eyebrow">DOPO LA PUBBLICAZIONE</p><h2>Il sito non finisce<br />quando va online.<br /><em>Inizia a lavorare.</em></h2></div><div class="continuity-content"><p class="statement">Un sito web aziendale diventa utile quando continua a spiegare bene l’offerta, sostenere le trattative e adattarsi alle priorità dell’impresa.</p><div class="continuity-steps"><article><small>01</small><h3>Evoluzioni utili</h3><p>Nuovi servizi, mercati, settori e casi vengono aggiunti quando aiutano clienti e responsabili acquisti a capire meglio l’azienda.</p></article><article><small>02</small><h3>Acquisizione misurabile</h3><p>Quando l’obiettivo è generare richieste, il sito può sostenere campagne <a href="/pubblicita-su-google">Google Ads</a>. Valutiamo pubblico, pagina di destinazione, tracciamento e budget prima di attivare il canale.</p></article><article><small>03</small><h3>Continuità tecnica</h3><p>Con hosting gestito integralmente da 4 Web Lab, la manutenzione tecnica ordinaria e straordinaria è inclusa. Per nuove attività definiamo prima priorità e perimetro.</p></article></div><p class="continuity-link"><a href="#contatti-aziendali">Parliamo della prossima priorità →</a></p></div></div></section>
  <section class="aziendali-price"><div class="wrap"><div class="price-card"><p class="plan-label">SITO WEB AZIENDALE</p><ul><li>✓ Architettura multipagina</li><li>✓ Design dedicato e versione mobile</li><li>✓ Base SEO tecnica e on-page</li><li>✓ Form, contatti e tracciamenti essenziali</li><li>✓ Pubblicazione e passaggio di consegne</li></ul><a class="button" href="#contatti-aziendali">Richiedi un preventivo →</a></div><div><p class="eyebrow light">Investimento</p><h2>Da <em>1.890 €</em><br />+ IVA.</h2><p>Una base pensata per un’azienda che deve spiegarsi bene, farsi trovare e sostenere la crescita nel tempo.</p></div></div></section>
  <section class="section wrap perizia-faq"><div><p class="eyebrow">Domande frequenti</p><h2>Prima di<br />decidere.</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
  <section id="contatti-aziendali" class="contact"><div class="wrap perizia-contact"><div><p class="eyebrow light">Parliamo della tua azienda</p><h2>Parti da ciò<br />che <em>rappresenti.</em></h2><p>Raccontaci obiettivo, servizi e pubblico: definiamo insieme quale struttura può diventare utile al vostro business.</p><a class="plain lime" href="https://wa.me/393514656042">WhatsApp ↗</a></div><form id="aziendali-form" method="post" action="https://api.web3forms.com/submit"><input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" /><input type="hidden" name="subject" value="Nuova richiesta sito web aziendale" /><input type="hidden" name="source_page" value="sito-web-aziendale" /><label>Nome e cognome *<input name="name" required autocomplete="name" /></label><label>Email *<input name="email" type="email" required autocomplete="email" /></label><label>Telefono<input name="phone" type="tel" autocomplete="tel" /></label><label>Azienda<input name="business" autocomplete="organization" /></label><label>Raccontaci di cosa hai bisogno *<textarea name="message" required rows="3"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><button class="button" type="submit">Invia la richiesta ↗</button><p class="privacy">I dati sono usati solo per rispondere alla richiesta. <a href="/privacy">Privacy policy</a>.</p><p id="aziendali-status" class="form-status" aria-live="polite"></p></form></div></section>
</main><SiteFooter />
<script is:inline>const form=document.querySelector('#aziendali-form'),status=document.querySelector('#aziendali-status');form?.addEventListener('submit',async event=>{event.preventDefault();if(form.website.value)return;const button=form.querySelector('button[type="submit"]');button.disabled=true;button.textContent='Invio in corso…';status.textContent='';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok||!data.success)throw new Error('send');form.reset();status.textContent='Richiesta inviata. Ti rispondiamo entro 24 ore lavorative.'}catch{status.textContent='Invio non riuscito. Riprova tra poco o contattaci su WhatsApp.'}finally{button.disabled=false;button.textContent='Invia la richiesta ↗'}});</script>
</body></html>


