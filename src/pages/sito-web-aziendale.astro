---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';

const pageUrl = `${SITE.url}/sito-web-aziendale`;
const faqs = [
  ['Quanto costa un sito web aziendale?', 'Un sito web aziendale parte da 1.890 € + IVA. Il preventivo dipende da struttura, pagine, contenuti, lingue e integrazioni realmente necessarie.'],
  ['Quanto tempo serve?', 'Un progetto aziendale richiede in media da 2 a 6 settimane, in base alla disponibilità dei contenuti e alla complessità del percorso.'],
  ['Il sito è adatto anche al B2B?', 'Sì. Per il B2B il sito deve rendere verificabili competenze, servizi, casi e canali di contatto prima della richiesta commerciale.'],
  ['Il sito include la SEO?', 'Ogni progetto include una base SEO tecnica e on-page. Visibilità e risultati dipendono poi da concorrenza, contenuti e attività continuative.'],
];
const structuredData = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Siti web aziendali', item: pageUrl }] },
  { '@type': 'Service', '@id': `${pageUrl}#service`, name: 'Siti web aziendali', description: 'Progettazione e realizzazione di siti web aziendali per PMI, imprese e attività B2B.', serviceType: 'Web design aziendale', provider: { '@id': `${SITE.url}/#business` }, areaServed: [{ '@type': 'AdministrativeArea', name: 'Veneto' }, { '@type': 'Country', name: 'Italia' }], url: pageUrl, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, offers: { '@type': 'Offer', priceCurrency: 'EUR', priceSpecification: { '@type': 'PriceSpecification', minPrice: '1890', priceCurrency: 'EUR', valueAddedTaxIncluded: false } } },
  { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
] }];
---

<!doctype html><html lang="it"><head><SeoHead title="Siti web aziendali per PMI e imprese | 4 Web Lab" description="Siti web aziendali per PMI e imprese: struttura, contenuti e SEO tecnica per rendere chiari servizi, competenze e contatti. Da 1.890 € + IVA." image="/images/og/sito-web-aziendale.webp" structuredData={structuredData} /></head><body>
<a class="skip" href="#contenuto">Vai al contenuto</a><SiteHeader contactTarget="#contatti-aziendali" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Siti web aziendali' }]} /></div></div>
  <section class="aziendali-hero"><div class="wrap aziendali-hero-grid"><div><p class="hero-location">Siti web aziendali · Padova / tutta Italia</p><h1>Siti web aziendali:<br /><em>struttura, contenuti e SEO tecnica.</em></h1><p class="lead">Un sito aziendale non è una brochure online: è il punto in cui clienti, partner e candidati verificano chi siete prima di scegliere se contattarvi.</p><div class="actions"><a class="button" href="#contatti-aziendali">Parliamo del progetto ↓</a><a class="plain light" href="#struttura-aziendale">Cosa costruiamo →</a></div></div><img src="/images/aziendali-mockup.webp" width="1280" height="960" alt="Mockup di un sito web aziendale" fetchpriority="high" /></div></section>
  <section class="section wrap aziendali-intro"><div><p class="eyebrow">Prima della chiamata</p><h2>Il sito deve<br />fare ordine.<br /><em>Non rumore.</em></h2></div><div><p class="statement">Chi vi cerca deve riconoscere subito cosa fate, per chi lo fate e perché siete una scelta credibile.</p><p>Architettura, testi e design lavorano insieme per rendere leggibili servizi, metodo, casi e prossimi passi. Senza affidare informazioni decisive a una presentazione generica.</p><p class="context-link">Quando serve generare domanda nel breve periodo, un sito solido diventa una destinazione utile per la <a href="/pubblicita-su-google">pubblicità su Google</a>, non una semplice pagina di atterraggio.</p></div></section>
  <section id="struttura-aziendale" class="aziendali-structure"><div class="aziendali-structure-grid"><div class="structure-heading"><p class="eyebrow">La struttura che serve</p><h2>Ogni pagina<br />ha un motivo<br /><em>per esistere.</em></h2></div><div class="structure-intro"><p class="statement">Progettiamo il percorso intorno alle domande che un potenziale cliente fa prima di aprire una trattativa.</p></div><div class="structure-points"><article><span>01</span><h3>Presentare l’offerta</h3><p>Servizi e soluzioni diventano consultabili, specifici e collegati ai problemi che risolvono.</p></article><article><span>02</span><h3>Dimostrare competenza</h3><p>Metodo, settori, team e casi aiutano a rendere concreto ciò che promettete.</p></article><article><span>03</span><h3>Aprire il contatto</h3><p>Call to action, form e canali diretti trasformano l’interesse in una richiesta comprensibile.</p><p class="context-link">Per proposte B2B o decisioni più ragionate, consideriamo anche la <a href="/pubblicita-su-chatgpt">pubblicità su ChatGPT</a> dopo una verifica concreta di fattibilità.</p></article></div></div></section>
  <section class="section wrap aziendali-proof"><div><img src="/images/aziendali-team.webp" width="1280" height="960" loading="lazy" alt="Team aziendale al lavoro" /></div><div><p class="eyebrow">Chi deve scegliervi</p><h2>Non cerca solo<br />un fornitore.<br /><em>Cerca prove.</em></h2><p class="statement">Nel B2B il sito accompagna una valutazione: deve essere chiaro senza semplificare ciò che rende distinta la vostra azienda.</p><ul><li><small>01</small><span>Contenuti chiari per clienti e responsabili acquisti</span></li><li><small>02</small><span>Base SEO per servizi, aree e domande rilevanti</span></li><li><small>03</small><span>Struttura tecnica veloce, accessibile e aggiornabile</span></li></ul></div></section>
  <section class="aziendali-price"><div class="wrap"><div class="price-card"><p class="plan-label">SITO WEB AZIENDALE</p><ul><li>✓ Architettura multipagina</li><li>✓ Design dedicato e versione mobile</li><li>✓ Base SEO tecnica e on-page</li><li>✓ Form, contatti e tracciamenti essenziali</li><li>✓ Pubblicazione e passaggio di consegne</li></ul><a class="button" href="#contatti-aziendali">Richiedi un preventivo →</a></div><div><p class="eyebrow light">Investimento</p><h2>Da <em>1.890 €</em><br />+ IVA.</h2><p>Una base pensata per un’azienda che deve spiegarsi bene, farsi trovare e sostenere la crescita nel tempo.</p></div></div></section>
  <section class="section wrap perizia-faq"><div><p class="eyebrow">Domande frequenti</p><h2>Prima di<br />decidere.</h2></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>
  <section id="contatti-aziendali" class="contact"><div class="wrap perizia-contact"><div><p class="eyebrow light">Parliamo della tua azienda</p><h2>Parti da ciò<br />che <em>rappresenti.</em></h2><p>Raccontaci obiettivo, servizi e pubblico: definiamo insieme quale struttura può diventare utile al vostro business.</p><a class="plain lime" href="https://wa.me/393514656042">WhatsApp ↗</a></div><form id="aziendali-form" method="post" action="https://api.web3forms.com/submit"><input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3" /><input type="hidden" name="subject" value="Nuova richiesta sito web aziendale" /><input type="hidden" name="source_page" value="sito-web-aziendale" /><label>Nome e cognome *<input name="name" required autocomplete="name" /></label><label>Email *<input name="email" type="email" required autocomplete="email" /></label><label>Telefono<input name="phone" type="tel" autocomplete="tel" /></label><label>Azienda<input name="business" autocomplete="organization" /></label><label>Raccontaci di cosa hai bisogno *<textarea name="message" required rows="3"></textarea></label><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><button class="button" type="submit">Invia la richiesta ↗</button><p class="privacy">I dati sono usati solo per rispondere alla richiesta. <a href="/privacy">Privacy policy</a>.</p><p id="aziendali-status" class="form-status" aria-live="polite"></p></form></div></section>
</main><SiteFooter />
<script is:inline>const form=document.querySelector('#aziendali-form'),status=document.querySelector('#aziendali-status');form?.addEventListener('submit',async event=>{event.preventDefault();if(form.website.value)return;const button=form.querySelector('button[type="submit"]');button.disabled=true;button.textContent='Invio in corso…';status.textContent='';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok||!data.success)throw new Error('send');form.reset();status.textContent='Richiesta inviata. Ti rispondiamo entro 24 ore lavorative.'}catch{status.textContent='Invio non riuscito. Riprova tra poco o contattaci su WhatsApp.'}finally{button.disabled=false;button.textContent='Invia la richiesta ↗'}});</script>
</body></html>


