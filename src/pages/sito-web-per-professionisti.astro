---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';
const pageUrl = `${SITE.url}/sito-web-per-professionisti`;
const audiences = ['Consulenti e liberi professionisti', 'Studi legali, commercialisti, architetti e tecnici', 'Medici, professionisti della salute e della formazione', 'Attività che vivono di reputazione, fiducia e primi contatti'];
const faqs = [['Quanto costa un sito per liberi professionisti?', 'I progetti partono da 990 € + IVA. Il costo finale dipende dal numero di pagine, dai contenuti da produrre e dalle funzionalità necessarie.'], ['Quanto tempo occorre?', 'In media il progetto richiede da 2 a 4 settimane dalla raccolta dei materiali e dall’analisi iniziale. I tempi dipendono anche dalla disponibilità dei contenuti e dai passaggi di revisione.'], ['Il sito sarà visibile su Google?', 'Ogni progetto include una base SEO on-page e tecnica. È una base necessaria per l’indicizzazione, ma risultati e tempi dipendono da concorrenza, contenuti e attività nel tempo.'], ['Posso aggiornare i contenuti?', 'Sì. Nuovi servizi, pubblicazioni, collaborazioni o cambiamenti di metodo possono essere integrati senza alterare la chiarezza del sito. La modalità di aggiornamento viene definita insieme; con hosting gestito integralmente da 4 Web Lab, la manutenzione tecnica ordinaria e straordinaria è inclusa.']];
const structuredData = [{ '@context':'https://schema.org', '@graph': [{ '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:`${SITE.url}/`},{ '@type':'ListItem',position:2,name:'Siti web per professionisti',item:pageUrl}] }, { '@type':'Service','@id':`${pageUrl}#service`,name:'Siti web per professionisti',description:'Realizzazione di siti web per liberi professionisti e studi professionali.',serviceType:'Web design per professionisti',provider:{'@id':`${SITE.url}/#business`},areaServed:[{'@type':'AdministrativeArea',name:'Veneto'},{'@type':'City',name:'Padova'}],url:pageUrl,inLanguage:'it-IT',isPartOf:{'@id':`${SITE.url}/#website`},offers:{'@type':'Offer',priceCurrency:'EUR',priceSpecification:{'@type':'PriceSpecification',minPrice:'990',priceCurrency:'EUR'}} }, { '@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}})) }]}];
---
<!doctype html>
<html lang="it">
<head>
<SeoHead title="Siti web per professionisti e studi a Padova | 4 Web Lab" description="Siti web per professionisti e studi a Padova: presenza autorevole, contenuti chiari e SEO tecnica. Progetti da 990 € + IVA." image="/images/og/sito-web-per-professionisti.webp" structuredData={structuredData}/>
</head>
<body>
<a class="skip" href="#contenuto">Vai al contenuto</a>
<SiteHeader contactTarget="#contatti-professionisti" />
<main id="contenuto">
  <div class="breadcrumb-strip"><div class="wrap"><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Siti web per professionisti' }]} /></div></div>
<section class="professionisti-hero">
<div class="wrap professionisti-hero-grid">
<div>
<p class="hero-location">Siti web per professionisti · Padova / tutta Italia</p>
<h1>Siti web per professionisti<br />
<em>e studi a Padova.</em>
</h1>
<p class="lead">Creiamo siti web professionali per consulenti, studi e liberi professionisti: una presenza chiara per spiegare cosa fai, come lavori e perché contattarti.</p>
<div class="actions">
<a class="button" href="#contatti-professionisti">Raccontaci il progetto ↓</a>
<a class="plain light" href="#cosa-include">Cosa comprende →</a>
</div>
</div>
</div>
</section>
<section class="section wrap professionisti-intro">
<div>
<p class="section-context">Prima del primo contatto</p>
<h2>La competenza deve essere chiara<br />
prima di essere scelta.
</h2>
</div>
<div>
<p class="statement">Prima di fissare un appuntamento, un potenziale cliente cerca segnali di competenza, metodo e affidabilità. Il sito deve rendere queste informazioni facili da trovare e da capire.</p>
<p>Organizziamo servizi, approccio e contenuti in un percorso leggibile, senza sovraccaricare chi sta ancora decidendo a chi rivolgersi.</p><p class="context-link">Se vuoi intercettare una domanda già esplicita, il sito può diventare la base per una <a href="/pubblicita-su-google">campagna Google Ads</a> costruita intorno a servizi, pubblico e obiettivi reali.</p>
</div>
<div class="professionisti-principles"><article><span class="service-signal">Metodo</span><h3>Presentare il metodo</h3><p>Spieghiamo servizi, approccio e competenze in un percorso semplice da consultare.</p></article><article><span class="service-signal">Chiarezza</span><h3>Rispondere prima del contatto</h3><p>Mostriamo le informazioni che aiutano una persona a capire se sei il professionista giusto.</p></article><article><span class="service-signal">Contatto</span><h3>Rendere facile agire</h3><p>Chi è pronto deve poter chiamare, scrivere o richiedere un appuntamento senza cercare il modo giusto per farlo.</p><p class="context-link">Per servizi complessi o consulenziali, valutiamo anche la <a href="/pubblicita-su-chatgpt">pubblicità su ChatGPT</a> solo quando il canale è pertinente al tuo pubblico.</p></article></div>
</section>
<section class="professionisti-audience">
<div class="wrap">
<p class="section-context">Per chi lavora sulla propria reputazione</p>
<h2>Un sito professionale<br />
<em>per farti capire.</em>
</h2>
<div>{audiences.map((item,index)=>
<article>
<small>0{index+1}</small>
<p>{item}</p>
</article>)}</div>
</div>
</section>
<section class="continuity-service professionisti-continuity"><div class="wrap continuity-grid"><div><p class="eyebrow">Dopo la pubblicazione</p><h2>Il sito resta aggiornato<br />mentre cresce<br /><em>il tuo lavoro.</em></h2></div><div class="continuity-content"><p class="statement">Servizi, competenze, collaborazioni e priorità possono cambiare. Il sito deve poterli seguire senza perdere chiarezza o autorevolezza.</p><div class="continuity-steps"><article><small>01</small><h3>Contenuti aggiornati con precisione</h3><p>Nuovi servizi, pubblicazioni, collaborazioni o cambiamenti di metodo possono essere integrati senza alterare la struttura del sito.</p></article><article><small>02</small><h3>Visibilità con un obiettivo</h3><p>Quando vuoi intercettare una domanda specifica, il sito può sostenere <a href="/pubblicita-su-google">campagne Google Ads</a>. Per servizi più complessi valutiamo altri canali solo se sono pertinenti al tuo pubblico.</p></article><article><small>03</small><h3>Un referente dopo il lancio</h3><p>Restiamo disponibili per mantenere il sito corretto, aggiornato e utile anche dopo la pubblicazione. Con hosting gestito integralmente da 4 Web Lab, la manutenzione tecnica ordinaria e straordinaria è inclusa.</p></article></div><p class="continuity-link"><a href="#contatti-professionisti">Hai un aggiornamento da integrare? Confrontiamoci →</a></p></div></div></section>
<section id="cosa-include" class="professionisti-price">
<div class="wrap">
<div>
<p class="eyebrow light">Investimento</p>
<h2>Da <em>990 €</em>
<br />+ IVA.</h2>
<p>Un sito web professionale su misura, a partire da tre pagine iniziali, design dedicato e ottimizzazione tecnica di base.</p>
</div>
<div class="price-card">
<p class="plan-label">SITO PER PROFESSIONISTI</p>
<ul>{['Design su misura', 'Fino a 3 pagine iniziali', 'Versione mobile', 'Base SEO on-page', 'Form e contatti diretti'].map(item=>
<li>✓ {item}</li>)}</ul>
<a class="button" href="#contatti-professionisti">Parliamo del progetto →</a>
</div>
</div>
</section>
<section class="section wrap perizia-faq">
<div>
<p class="eyebrow">Domande frequenti</p>
<h2>Dettagli<br />importanti.</h2>
</div>
<div>{faqs.map(([question,answer])=>
<details>
<summary>{question}<span>+</span>
</summary>
<p>{answer}</p>
</details>)}</div>
</section>
<section id="contatti-professionisti" class="contact">
<div class="wrap perizia-contact">
<div>
<p class="eyebrow light">Parliamo del tuo lavoro</p>
<h2>Parti da ciò<br />
<em>che sai fare.</em>
</h2>
<p>Raccontaci attività, obiettivo e pubblico: capiamo insieme quale sito può presentare il tuo lavoro con chiarezza e credibilità.</p>
<a class="plain lime" href="https://wa.me/393514656042">WhatsApp ↗</a>
</div>
<form id="professionisti-form" method="post" action="https://api.web3forms.com/submit">
<input type="hidden" name="access_key" value="2afa7184-7e7d-4881-9472-d10ca4e3c6c3"/>
<input type="hidden" name="subject" value="Nuova richiesta sito web per professionista"/>
<input type="hidden" name="source_page" value="sito-web-per-professionisti"/>
<label>Nome e cognome *<input name="name" required autocomplete="name"/>
</label>
<label>Email *<input name="email" type="email" required autocomplete="email"/>
</label>
<label>Telefono<input name="phone" type="tel" autocomplete="tel"/>
</label>
<label>Professione o studio<input name="business" autocomplete="organization"/>
</label>
<label>Raccontaci di cosa hai bisogno *<textarea name="message" required rows="3">
</textarea>
</label>
<label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/>
</label>
<button class="button" type="submit">Invia la richiesta ↗</button>
<p class="privacy">I dati sono usati solo per rispondere alla richiesta. <a href="/privacy">Privacy policy</a>.</p>
<p id="professionisti-status" class="form-status" aria-live="polite">
</p>
</form>
</div>
</section>
</main>
<SiteFooter />
<script is:inline>const form=document.querySelector('#professionisti-form'),status=document.querySelector('#professionisti-status');form?.addEventListener('submit',async event=>{event.preventDefault();if(form.website.value)return;const button=form.querySelector('button[type="submit"]');button.disabled=true;button.textContent='Invio in corso…';status.textContent='';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form)}),data=await response.json();if(!response.ok||!data.success)throw new Error('send');form.reset();status.textContent='Richiesta inviata. Ti rispondiamo entro 24 ore lavorative.'}catch{status.textContent='Invio non riuscito. Riprova tra poco o contattaci su WhatsApp.'}finally{button.disabled=false;button.textContent='Invia la richiesta ↗'}});</script>
</body>
</html>



